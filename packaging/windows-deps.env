# The libraries Patina needs on Windows, pinned by digest: GitHub release
# assets are not immutable. Read by packaging/windows-deps.ps1, which ci.yml
# and release.yml run; the workflows also load these lines into their env.
#
# libmpv: zhongfly/mpv-winbuild's LGPL build, the one Patina's Windows folder
# carries. It is a snapshot of mpv's master branch, and zhongfly deletes
# releases after about 30 days, so this URL stops working around late
# November. ci.yml's download cache keeps CI going for as long as master
# runs at least once a week; release.yml caches nothing and downloads afresh,
# so a release needs a live pin. Once the URL has gone, bump the pin to a
# release at least a day old (zhongfly replaces a same-day rebuild under the
# same tag), whose digest this prints:
#   gh api repos/zhongfly/mpv-winbuild/releases --jq '.[] | .assets[] | select(.name | test("^mpv-dev-lgpl-x86_64-[0-9]")) | "\(.browser_download_url) \(.digest | ltrimstr("sha256:"))"'
WIN_LIBMPV_URL=https://github.com/zhongfly/mpv-winbuild/releases/download/2026-10-29-6ee40e64d3/mpv-dev-lgpl-x86_64-20261029-git-6ee40e64d3.7z
WIN_LIBMPV_SHA256=0dca96400dfddecb74db5386a8fa0e2ee263748e11c8c069e46bd9bdac56c58b

# vulkan-1.dll: libmpv-2.dll imports it directly (no delay load), and a
# machine without a GPU driver has none, so the DLL would fail to load. This
# is mpv's own 0.41.0 release for Windows, which ships the loader beside
# mpv.exe; its copy needs only system DLLs.
WIN_VULKAN_URL=https://github.com/mpv-player/mpv/releases/download/v0.41.0/mpv-v0.41.0-x86_64-pc-windows-msvc.zip
WIN_VULKAN_SHA256=4e197f729f5071c6772f35fffd96e0f36e3e8a044bd9479b136bb09b7c6a80ff

# ffmpeg.exe, for the tests only: Gyan's "essentials" release build, which
# includes libx264 (the thumbnail test encodes with it). Gyan keeps release
# tags.
WIN_FFMPEG_URL=https://github.com/GyanD/codexffmpeg/releases/download/9.0.2/ffmpeg-9.0.2-essentials_build.7z
WIN_FFMPEG_SHA256=4705843ccaaf54257c16ad90f3e952ece33c17df964ecf7bfdbb0f49c7171077
