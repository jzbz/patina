# Build tools, built for the runner and never shipped. nasm assembles the
# x86_64 assembly in FFmpeg, dav1d (which needs 2.14 or later) and libass;
# pkgconf is the pkg-config every build here finds its dependencies with.
# meson, ninja and cmake come from PyPI instead, pinned in
# macos-build-tools.txt.
NASM_VERSION=3.02
NASM_URL=https://www.nasm.us/pub/nasm/releasebuilds/3.02/nasm-3.02.tar.xz
