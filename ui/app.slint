import { Theme } from "theme.slint";
import { Platform, Playback, Media, Osd, Prefs, Actions, PlaylistItem, TrackItem, ChapterItem, RecentItem, DeviceItem, QualityItem, MenuPlayback, MenuMedia, OnlineSubs, OnlineSubtitle } from "globals.slint";
import { ControlBar, TitleBar, OsdView, SeekPreview } from "controls.slint";
import { Sidebar } from "sidebar.slint";
import { MainMenu } from "menus.slint";
import { WelcomeView } from "welcome.slint";
import { MusicPanel, MusicWindowButtons, DefaultArt } from "music.slint";
import { PromptDialog, ConfirmDialog, AboutDialog, ShortcutsDialog, ShortcutItem, OnlineSubtitlesDialog } from "dialogs.slint";
import { Spinner, IconButton } from "widgets.slint";
import { PreferencesWindow, PrefRow, BindingRow } from "preferences.slint";
import { HistoryWindow, HistoryRow } from "history.slint";
import { DownloadsWindow, DownloadRow } from "downloads.slint";
import { InspectorWindow, InspectorRow } from "inspector.slint";

export { Platform, Playback, Media, Osd, Prefs, Actions, PlaylistItem, TrackItem, ChapterItem, RecentItem, DeviceItem, ShortcutItem, PreferencesWindow, PrefRow, BindingRow, HistoryWindow, HistoryRow, DownloadsWindow, DownloadRow, InspectorWindow, InspectorRow, QualityItem, OnlineSubs, OnlineSubtitle }

export component PlayerWindow inherits Window {
    title: !Playback.has-media ? "Patina" : root.music-mode && Playback.music-title != "" ? Playback.music-title : Playback.title;
    icon: @image-url("icons/patina.svg");
    background: black;
    no-frame: Platform.custom-titlebar;
    resize-border-width: Platform.custom-titlebar && !root.full-screen && !root.maximized ? 6px : 0px;
    // Music mode is 300 wide, like IINA's mini player, and as tall as its
    // cover and controls at least; dragging it taller opens the playlist.
    // From 2^31 px on Slint sets no maximum at all.
    min-width: root.music-mode ? 300px : 360px;
    min-height: root.music-mode ? root.music-art-height + 72px : 220px;
    max-width: root.music-mode ? 300px : 3000000000px;
    preferred-width: 960px;
    preferred-height: 600px;
    default-font-size: Theme.font-normal;
    always-on-top: root.float-on-top;

    in-out property <bool> float-on-top;
    // The compact always-on-top window that stands in for picture-in-picture.
    in-out property <bool> pip;
    // IINA's music mode: the cover, a strip of controls under it, and the
    // sidebar's playlist as a drawer below (sidebar-open).
    in-out property <bool> music-mode;
    in-out property <bool> music-art: true;
    out property <length> music-art-height: root.music-art ? 300px / Playback.picture-aspect : 0px;
    // Where mpv's picture goes, which is all of the window but in music mode.
    out property <length> video-width: root.width;
    out property <length> video-height: root.music-mode ? root.music-art-height : root.height;
    in-out property <bool> sidebar-open;
    in-out property <string> sidebar-tab: "playlist";
    in-out property <bool> controls-visible: true;
    in-out property <bool> drop-active;
    // "", "open-url", "add-url", "jump-to", "about", "shortcuts",
    // "online-subtitles".
    in-out property <string> dialog;
    in-out property <string> dialog-text;
    in property <[ShortcutItem]> shortcuts;
    in property <string> error;
    in-out property <length> osc-offset-x;
    in-out property <length> osc-offset-y;
    // Set while a dialog or menu needs the pointer, so controls stay put.
    property <bool> keep-controls: !Playback.has-media || root.dialog != "" || osc-hover.has-hover || root.title-hovered || osc.seek-hovering || (root.pip && (root.pip-play-hovered || root.pip-exit-hovered));
    property <bool> title-hovered;
    property <bool> pip-play-hovered;
    property <bool> pip-exit-hovered;
    // How far the sidebar is out, animated; not in music mode, where the
    // sidebar is the drawer and doesn't slide.
    property <float> sidebar-shown: root.sidebar-open && !root.music-mode ? 1 : 0;
    animate sidebar-shown { duration: 200ms; easing: ease-out; }
    property <bool> show-chrome: root.controls-visible || root.keep-controls;
    property <string> pending-click;
    property <int> volume-shows;

    callback dialog-confirmed(string, string);
    callback video-area-changed();

    public function show-controls() {
        root.controls-visible = true;
        // restart() alone never starts a timer that isn't running.
        hide-timer.restart();
        hide-timer.running = true;
    }

    // A volume change made in music mode, which has no OSD.
    public function show-volume() {
        root.volume-shows += 1;
    }

    public function toggle-sidebar(tab: string) {
        // Music mode's drawer holds the playlist and chapters only.
        if root.music-mode && tab != "playlist" && tab != "chapters" {
            return;
        }
        let same-group = (tab == "playlist" || tab == "chapters") == (root.sidebar-tab == "playlist" || root.sidebar-tab == "chapters");
        if root.sidebar-open && (tab == root.sidebar-tab || (tab == "settings" && same-group)) {
            root.sidebar-open = false;
        } else {
            if tab != "settings" || !same-group {
                root.sidebar-tab = tab == "settings" ? "video" : tab;
            }
            root.sidebar-open = true;
        }
    }

    public function close-sidebar() {
        root.sidebar-open = false;
    }

    public function show-menu-at(x: length, y: length) {
        root.open-menu(x, y);
    }

    // Opens the application menu on what is true now (see MenuPlayback).
    function open-menu(x: length, y: length) {
        MenuPlayback.has-media = Playback.has-media;
        MenuPlayback.has-video = Playback.has-video;
        MenuPlayback.seekable = Playback.seekable;
        MenuPlayback.paused = Playback.paused;
        MenuPlayback.muted = Playback.muted;
        MenuPlayback.speed = Playback.speed;
        MenuPlayback.fullscreen = Playback.fullscreen;
        MenuPlayback.on-top = Playback.on-top;
        MenuPlayback.music-mode = Playback.music-mode;
        MenuPlayback.loop-file = Playback.loop-file;
        MenuPlayback.loop-playlist = Playback.loop-playlist;
        MenuPlayback.shuffle = Playback.shuffle;
        MenuPlayback.ab-a = Playback.ab-a;
        MenuPlayback.ab-b = Playback.ab-b;
        MenuPlayback.aspect-index = Playback.aspect-index;
        MenuPlayback.crop-index = Playback.crop-index;
        MenuPlayback.rotation = Playback.rotation;
        MenuPlayback.flipped = Playback.flipped;
        MenuPlayback.mirrored = Playback.mirrored;
        MenuPlayback.deinterlace = Playback.deinterlace;
        MenuPlayback.audio-delay = Playback.audio-delay;
        MenuPlayback.sub-delay = Playback.sub-delay;
        MenuPlayback.sub-scale = Playback.sub-scale;
        MenuPlayback.sub-visible = Playback.sub-visible;
        MenuMedia.playlist-count = Media.playlist.length;
        MenuMedia.playlist-pos = Media.playlist-pos;
        MenuMedia.recent = Media.recent;
        MenuMedia.chapters = Media.chapters;
        MenuMedia.video-tracks = Media.video-tracks;
        MenuMedia.audio-tracks = Media.audio-tracks;
        MenuMedia.sub-tracks = Media.sub-tracks;
        MenuMedia.secondary-sub-tracks = Media.secondary-sub-tracks;
        MenuMedia.audio-devices = Media.audio-devices;
        MenuMedia.video-qualities = Media.video-qualities;
        MenuMedia.audio-qualities = Media.audio-qualities;
        MenuMedia.online = Media.online;
        MenuMedia.downloaded-subtitle = Media.downloaded-subtitle;
        menu.show({ x: x, y: y });
    }

    function run-mouse-action(action: string) {
        // Music mode keeps pausing, as IINA's mini player does, and the menu.
        if root.music-mode && action != "pause" && action != "context-menu" {
            return;
        }
        if action == "pause" {
            Actions.mpv(["cycle", "pause"]);
        } else if action == "fullscreen" {
            Actions.patina("toggle-fullscreen");
        } else if action == "toggle-osc" {
            if root.controls-visible {
                root.controls-visible = false;
                hide-timer.stop();
            } else {
                root.show-controls();
            }
        } else if action == "context-menu" {
            root.open-menu(video-touch.mouse-x, video-touch.mouse-y);
        } else if action == "pip" {
            Actions.patina("toggle-pip");
        } else if action == "ab-loop" {
            Actions.mpv(["ab-loop"]);
        } else if action == "reset-speed" {
            Actions.set("speed", "1");
        }
    }

    hide-timer := Timer {
        interval: Prefs.osc-timeout;
        running: false;
        triggered => {
            self.running = false;
            root.controls-visible = false;
        }
    }

    click-timer := Timer {
        interval: 280ms;
        running: false;
        triggered => {
            self.running = false;
            root.run-mouse-action(root.pending-click);
        }
    }

    forward-focus: keys;

    // The menus read the window's state through globals, being copied into
    // the menu bar below as well as used in MainMenu.
    init => {
        Playback.fullscreen = self.full-screen;
        Playback.on-top = self.always-on-top;
    }
    changed full-screen => {
        Playback.fullscreen = self.full-screen;
    }
    changed always-on-top => {
        Playback.on-top = self.always-on-top;
    }
    changed music-mode => {
        Playback.music-mode = self.music-mode;
    }
    changed pip => {
        root.pip-play-hovered = false;
        root.pip-exit-hovered = false;
    }
    // Music mode sizes the window to what it shows.
    changed sidebar-open => {
        if self.music-mode {
            Actions.patina("music-layout");
        }
    }
    changed music-art => {
        if self.music-mode {
            Actions.patina("music-layout");
        }
    }
    // A dialog needs more room than music mode's strip.
    changed dialog => {
        if self.music-mode {
            Actions.patina("music-layout");
        }
    }
    changed video-width => {
        root.video-area-changed();
    }
    changed video-height => {
        root.video-area-changed();
    }
    changed show-chrome => {
        Actions.chrome-visible(self.show-chrome);
    }

    // macOS's menu bar, which Slint shows natively there (ahead of it, the
    // app menu Slint adds itself); the other platforms have none, and reach
    // the same menus from the title bar's button and a right click.
    // Generated from MainMenu by tools/menubar.py; edit menus.slint, then run
    // it (a test fails while the two differ).
    if Platform.macos: MenuBar {
        // BEGIN tools/menubar.py
        Menu {
            title: "File";
            MenuItem {
                title: "Open…";
                activated => {
                    Actions.patina("open-file");
                }
            }
            MenuItem {
                title: "Open URL…";
                activated => {
                    Actions.patina("open-url");
                }
            }
            MenuItem {
                title: "Open Folder…";
                activated => {
                    Actions.patina("open-folder");
                }
            }
            Menu {
                title: "Open Recent";
                for item[index] in Media.recent: MenuItem {
                    title: item.title;
                    activated => {
                        Actions.open-recent(index);
                    }
                }
                MenuSeparator { }
                MenuItem {
                    title: "Clear Menu";
                    enabled: Media.recent.length > 0;
                    activated => {
                        Actions.patina("clear-recent");
                    }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Add Files to Playlist…";
                activated => {
                    Actions.patina("add-files");
                }
            }
            MenuItem {
                title: "Save Playlist…";
                enabled: Media.playlist.length > 0;
                activated => {
                    Actions.patina("save-playlist");
                }
            }
            MenuItem {
                title: "Show in File Manager";
                enabled: Playback.has-media;
                activated => {
                    Actions.patina("reveal-file");
                }
            }
            MenuItem {
                title: "Move to Trash";
                enabled: Playback.has-media;
                activated => {
                    Actions.patina("delete-current-file");
                }
            }
            MenuItem {
                title: "Playback History…";
                activated => {
                    Actions.patina("history");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Download Video";
                enabled: Media.online;
                activated => {
                    Actions.patina("download-video");
                }
            }
            MenuItem {
                title: "Downloads…";
                activated => {
                    Actions.patina("downloads");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Preferences…";
                activated => {
                    Actions.patina("preferences");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "New Window";
                activated => {
                    Actions.patina("new-window");
                }
            }
            MenuItem {
                title: "Close Window";
                activated => {
                    Actions.patina("close-window");
                }
            }
            MenuItem {
                title: "Quit Patina";
                activated => {
                    Actions.patina("quit");
                }
            }
        }

        Menu {
            title: "Playback";
            MenuItem {
                title: Playback.paused ? "Resume" : "Pause";
                enabled: Playback.has-media;
                activated => {
                    Actions.mpv(["cycle", "pause"]);
                }
            }
            MenuItem {
                title: "Stop";
                enabled: Playback.has-media;
                activated => {
                    Actions.mpv(["stop"]);
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Step Forward";
                enabled: Playback.has-media;
                activated => {
                    Actions.mpv(["frame-step"]);
                }
            }
            MenuItem {
                title: "Step Backward";
                enabled: Playback.has-media;
                activated => {
                    Actions.mpv(["frame-back-step"]);
                }
            }
            MenuItem {
                title: "Jump Forward 5 s";
                enabled: Playback.seekable;
                activated => {
                    Actions.mpv(["seek", "5"]);
                }
            }
            MenuItem {
                title: "Jump Backward 5 s";
                enabled: Playback.seekable;
                activated => {
                    Actions.mpv(["seek", "-5"]);
                }
            }
            MenuItem {
                title: "Jump to Beginning";
                enabled: Playback.seekable;
                activated => {
                    Actions.mpv(["seek", "0", "absolute"]);
                }
            }
            MenuItem {
                title: "Jump To…";
                enabled: Playback.seekable;
                activated => {
                    Actions.patina("jump-to");
                }
            }
            MenuSeparator { }
            Menu {
                title: "Speed";
                MenuItem {
                    title: "Speed Up ×2";
                    activated => {
                        Actions.mpv(["multiply", "speed", "2"]);
                    }
                }
                MenuItem {
                    title: "Speed Up 10%";
                    activated => {
                        Actions.mpv(["multiply", "speed", "1.1"]);
                    }
                }
                MenuItem {
                    title: "Slow Down ×0.5";
                    activated => {
                        Actions.mpv(["multiply", "speed", "0.5"]);
                    }
                }
                MenuItem {
                    title: "Slow Down 10%";
                    activated => {
                        Actions.mpv(["multiply", "speed", "0.9091"]);
                    }
                }
                MenuItem {
                    title: "Normal Speed";
                    checked: Playback.speed == 1;
                    activated => {
                        Actions.set("speed", "1");
                    }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: Playback.ab-b >= 0 ? "Clear A-B Loop" : Playback.ab-a >= 0 ? "Set A-B Loop End" : "Set A-B Loop Start";
                enabled: Playback.seekable;
                activated => {
                    Actions.mpv(["ab-loop"]);
                }
            }
            MenuItem {
                title: "Loop File";
                checked: Playback.loop-file;
                enabled: Playback.has-media;
                activated => {
                    Actions.patina("toggle-loop-file");
                }
            }
            MenuItem {
                title: "Loop Playlist";
                checked: Playback.loop-playlist;
                activated => {
                    Actions.patina("toggle-loop-playlist");
                }
            }
            MenuItem {
                title: "Shuffle";
                checked: Playback.shuffle;
                activated => {
                    Actions.patina("toggle-shuffle");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Previous Item";
                enabled: Media.playlist-pos > 0;
                activated => {
                    Actions.mpv(["playlist-prev"]);
                }
            }
            MenuItem {
                title: "Next Item";
                enabled: Media.playlist-pos >= 0 && Media.playlist-pos < Media.playlist.length - 1;
                activated => {
                    Actions.mpv(["playlist-next"]);
                }
            }
            MenuItem {
                title: "Playlist…";
                activated => {
                    Actions.patina("toggle-sidebar playlist");
                }
            }
            Menu {
                title: "Chapters";
                enabled: Media.chapters.length > 0;
                MenuItem {
                    title: "Previous Chapter";
                    activated => {
                        Actions.mpv(["add", "chapter", "-1"]);
                    }
                }
                MenuItem {
                    title: "Next Chapter";
                    activated => {
                        Actions.mpv(["add", "chapter", "1"]);
                    }
                }
                MenuSeparator { }
                for chapter[index] in Media.chapters: MenuItem {
                    title: chapter.time-text + "  " + chapter.title;
                    checked: chapter.current;
                    activated => {
                        Actions.select-chapter(index);
                    }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Take Screenshot";
                enabled: Playback.has-video;
                activated => {
                    Actions.patina("screenshot");
                }
            }
            MenuItem {
                title: "Take Screenshot without Subtitles";
                enabled: Playback.has-video;
                activated => {
                    Actions.patina("screenshot video");
                }
            }
            MenuItem {
                title: "Open Screenshot Folder";
                activated => {
                    Actions.patina("open-screenshot-folder");
                }
            }
        }

        Menu {
            title: "Video";
            MenuItem {
                title: Playback.fullscreen ? "Exit Fullscreen" : "Enter Fullscreen";
                enabled: !Playback.music-mode;
                activated => {
                    Actions.patina("toggle-fullscreen");
                }
            }
            MenuItem {
                title: "Float on Top";
                checked: Playback.on-top;
                activated => {
                    Actions.patina("toggle-ontop");
                }
            }
            MenuItem {
                title: "Picture in Picture";
                enabled: Playback.has-video && !Playback.music-mode;
                activated => {
                    Actions.patina("toggle-pip");
                }
            }
            MenuItem {
                title: Playback.music-mode ? "Exit Music Mode" : "Enter Music Mode";
                enabled: Playback.has-media || Playback.music-mode;
                activated => {
                    Actions.patina("toggle-music-mode");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Half Size";
                enabled: Playback.has-video && !Playback.music-mode;
                activated => {
                    Actions.patina("window-scale 0.5");
                }
            }
            MenuItem {
                title: "Normal Size";
                enabled: Playback.has-video && !Playback.music-mode;
                activated => {
                    Actions.patina("window-scale 1");
                }
            }
            MenuItem {
                title: "Double Size";
                enabled: Playback.has-video && !Playback.music-mode;
                activated => {
                    Actions.patina("window-scale 2");
                }
            }
            MenuItem {
                title: "Fit to Screen";
                enabled: Playback.has-video && !Playback.music-mode;
                activated => {
                    Actions.patina("fit-to-screen");
                }
            }
            MenuItem {
                title: "Bigger Window";
                enabled: Playback.has-video && !Playback.music-mode;
                activated => {
                    Actions.patina("bigger-window");
                }
            }
            MenuItem {
                title: "Smaller Window";
                enabled: Playback.has-video && !Playback.music-mode;
                activated => {
                    Actions.patina("smaller-window");
                }
            }
            MenuSeparator { }
            Menu {
                title: "Video Track";
                enabled: Media.video-tracks.length > 0;
                for track in Media.video-tracks: MenuItem {
                    title: track.title;
                    checked: track.selected;
                    activated => {
                        Actions.select-track("video", track.id);
                    }
                }
            }
            Menu {
                title: "Video Quality";
                enabled: Media.video-qualities.length > 1;
                for item in Media.video-qualities: MenuItem {
                    title: item.title;
                    checked: item.selected;
                    activated => {
                        Actions.patina("video-quality " + item.key);
                    }
                }
            }
            Menu {
                title: "Aspect Ratio";
                for label[index] in ["Default", "4:3", "16:9", "16:10", "21:9", "5:4"]: MenuItem {
                    title: label;
                    checked: Playback.aspect-index == index;
                    activated => {
                        Actions.patina("aspect " + index);
                    }
                }
            }
            Menu {
                title: "Crop";
                for label[index] in ["None", "4:3", "16:9", "16:10", "21:9", "5:4"]: MenuItem {
                    title: label;
                    checked: Playback.crop-index == index;
                    activated => {
                        Actions.patina("crop " + index);
                    }
                }
            }
            Menu {
                title: "Rotation";
                for degrees in [0, 90, 180, 270]: MenuItem {
                    title: degrees + "°";
                    checked: Playback.rotation == degrees;
                    activated => {
                        Actions.set("video-rotate", degrees);
                    }
                }
            }
            MenuItem {
                title: "Flip";
                checked: Playback.flipped;
                activated => {
                    Actions.patina("toggle-flip");
                }
            }
            MenuItem {
                title: "Mirror";
                checked: Playback.mirrored;
                activated => {
                    Actions.patina("toggle-mirror");
                }
            }
            MenuItem {
                title: "Deinterlace";
                checked: Playback.deinterlace;
                activated => {
                    Actions.mpv(["cycle", "deinterlace"]);
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Video Settings…";
                enabled: !Playback.music-mode;
                activated => {
                    Actions.patina("toggle-sidebar video");
                }
            }
        }

        Menu {
            title: "Audio";
            Menu {
                title: "Audio Track";
                enabled: Media.audio-tracks.length > 1;
                for track in Media.audio-tracks: MenuItem {
                    title: track.title;
                    checked: track.selected;
                    activated => {
                        Actions.select-track("audio", track.id);
                    }
                }
            }
            Menu {
                title: "Audio Quality";
                enabled: Media.audio-qualities.length > 1;
                for item in Media.audio-qualities: MenuItem {
                    title: item.title;
                    checked: item.selected;
                    activated => {
                        Actions.patina("audio-quality " + item.key);
                    }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Volume Up";
                activated => {
                    Actions.mpv(["add", "volume", "5"]);
                }
            }
            MenuItem {
                title: "Volume Down";
                activated => {
                    Actions.mpv(["add", "volume", "-5"]);
                }
            }
            MenuItem {
                title: "Mute";
                checked: Playback.muted;
                activated => {
                    Actions.mpv(["cycle", "mute"]);
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Audio Delay +0.5 s";
                activated => {
                    Actions.mpv(["add", "audio-delay", "0.5"]);
                }
            }
            MenuItem {
                title: "Audio Delay −0.5 s";
                activated => {
                    Actions.mpv(["add", "audio-delay", "-0.5"]);
                }
            }
            MenuItem {
                title: "Reset Audio Delay";
                enabled: Playback.audio-delay != 0;
                activated => {
                    Actions.set("audio-delay", "0");
                }
            }
            MenuSeparator { }
            Menu {
                title: "Audio Device";
                for device in Media.audio-devices: MenuItem {
                    title: device.description;
                    checked: device.selected;
                    activated => {
                        Actions.set("audio-device", device.name);
                    }
                }
            }
            MenuItem {
                title: "Load External Audio…";
                enabled: Playback.has-media;
                activated => {
                    Actions.patina("load-audio");
                }
            }
            MenuItem {
                title: "Audio Settings…";
                enabled: !Playback.music-mode;
                activated => {
                    Actions.patina("toggle-sidebar audio");
                }
            }
        }

        Menu {
            title: "Subtitles";
            Menu {
                title: "Subtitle";
                enabled: Playback.has-media;
                for track in Media.sub-tracks: MenuItem {
                    title: track.title;
                    checked: track.selected;
                    activated => {
                        Actions.select-track("sub", track.id);
                    }
                }
            }
            Menu {
                title: "Secondary Subtitle";
                enabled: Playback.has-media;
                for track in Media.secondary-sub-tracks: MenuItem {
                    title: track.title;
                    checked: track.selected;
                    activated => {
                        Actions.select-secondary-sub(track.id);
                    }
                }
            }
            MenuItem {
                title: "Load External Subtitle…";
                enabled: Playback.has-media;
                activated => {
                    Actions.patina("load-subtitles");
                }
            }
            MenuItem {
                title: "Find Online Subtitles…";
                enabled: Playback.has-media;
                activated => {
                    Actions.patina("find-online-subtitles");
                }
            }
            MenuItem {
                title: "Save Downloaded Subtitle…";
                enabled: Media.downloaded-subtitle;
                activated => {
                    Actions.patina("save-downloaded-subtitle");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Show Subtitles";
                checked: Playback.sub-visible;
                activated => {
                    Actions.mpv(["cycle", "sub-visibility"]);
                }
            }
            MenuItem {
                title: "Delay +0.5 s";
                activated => {
                    Actions.mpv(["add", "sub-delay", "0.5"]);
                }
            }
            MenuItem {
                title: "Delay −0.5 s";
                activated => {
                    Actions.mpv(["add", "sub-delay", "-0.5"]);
                }
            }
            MenuItem {
                title: "Reset Delay";
                enabled: Playback.sub-delay != 0;
                activated => {
                    Actions.set("sub-delay", "0");
                }
            }
            MenuItem {
                title: "Bigger";
                activated => {
                    Actions.mpv(["add", "sub-scale", "0.1"]);
                }
            }
            MenuItem {
                title: "Smaller";
                activated => {
                    Actions.mpv(["add", "sub-scale", "-0.1"]);
                }
            }
            MenuItem {
                title: "Reset Size";
                enabled: Playback.sub-scale != 1;
                activated => {
                    Actions.set("sub-scale", "1");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Subtitle Settings…";
                enabled: !Playback.music-mode;
                activated => {
                    Actions.patina("toggle-sidebar subtitles");
                }
            }
        }

        Menu {
            title: "Window";
            MenuItem {
                title: "Minimize";
                activated => {
                    Actions.patina("minimize");
                }
            }
            MenuItem {
                title: "Playlist";
                activated => {
                    Actions.patina("toggle-sidebar playlist");
                }
            }
            MenuItem {
                title: "Chapters";
                activated => {
                    Actions.patina("toggle-sidebar chapters");
                }
            }
            MenuItem {
                title: "Quick Settings";
                enabled: !Playback.music-mode;
                activated => {
                    Actions.patina("toggle-sidebar video");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Inspector";
                activated => {
                    Actions.patina("inspector");
                }
            }
            MenuItem {
                title: "Playback History";
                activated => {
                    Actions.patina("history");
                }
            }
        }

        Menu {
            title: "Help";
            MenuItem {
                title: "Keyboard Shortcuts";
                activated => {
                    Actions.patina("show-shortcuts");
                }
            }
            MenuItem {
                title: "Patina Website";
                activated => {
                    Actions.patina("open-website");
                }
            }
            MenuItem {
                title: "About Patina";
                activated => {
                    Actions.patina("about");
                }
            }
        }
        // END tools/menubar.py
    }

    keys := FocusScope {
        key-pressed(event) => {
            Actions.activity();
            if event.text == Key.Escape && root.sidebar-open && !root.full-screen {
                root.sidebar-open = false;
                return accept;
            }
            if Actions.key(event.text, event.modifiers.shift, event.modifiers.control, event.modifiers.alt, event.modifiers.meta, event.repeat) {
                return accept;
            }
            return reject;
        }

        menu := MainMenu {
            enabled: false;

            // The video, drawn by mpv into a texture. Without a picture the
            // texture holds whatever was shown last.
            if Playback.has-media: Image {
                x: 0;
                y: 0;
                width: root.video-width;
                height: root.video-height;
                visible: Playback.has-picture;
                source: Playback.video-frame;
                image-fit: fill;
            }

            if root.music-mode && (!Playback.has-media || !Playback.has-picture) && root.music-art-height > 0: DefaultArt {
                x: 0;
                y: 0;
                width: root.width;
                height: root.music-art-height;
            }

            WindowMoveArea {
                enabled: !root.full-screen;

                video-touch := TouchArea {
                    mouse-cursor: Playback.has-media && !root.show-chrome && !root.music-mode ? MouseCursor.none : MouseCursor.default;
                    moved => {
                        root.show-controls();
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.move {
                            root.show-controls();
                            return;
                        }
                        if event.kind != PointerEventKind.down {
                            return;
                        }
                        Actions.activity();
                        if event.button == PointerEventButton.right {
                            root.run-mouse-action(Prefs.right-click);
                        } else if event.button == PointerEventButton.middle {
                            root.run-mouse-action(Prefs.middle-click);
                        }
                    }
                    clicked => {
                        if !Playback.has-media {
                            return;
                        }
                        // Music mode has no double-click action but pausing.
                        if Prefs.double-click == "none" || (root.music-mode && Prefs.double-click != "pause") {
                            root.run-mouse-action(Prefs.single-click);
                        } else {
                            root.pending-click = Prefs.single-click;
                            click-timer.restart();
                            click-timer.running = true;
                        }
                    }
                    double-clicked => {
                        click-timer.running = false;
                        if Playback.has-media {
                            root.run-mouse-action(Prefs.double-click);
                        }
                    }
                    scroll-event(event) => {
                        if !Playback.has-media {
                            return reject;
                        }
                        Actions.activity();
                        Actions.wheel(event.delta-x / 1px, event.delta-y / 1px);
                        return accept;
                    }
                }
            }

            // Over the area above, which would otherwise take every click
            // meant for its buttons: what the welcome screen doesn't take
            // itself still reaches it, to move the window or open the menu.
            if !Playback.has-media && !root.music-mode: WelcomeView {
                width: parent.width;
                height: parent.height;
                drop-active: root.drop-active;
                clear-recent => {
                    root.dialog = "clear-recent";
                }
            }
        }

        if Playback.buffering && Playback.has-media && (!root.music-mode || root.music-art-height >= 80px): VerticalLayout {
            x: (parent.width - self.width) / 2;
            y: ((root.music-mode ? root.music-art-height : parent.height) - self.height) / 2;
            width: 120px;
            height: 80px;
            spacing: 10px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Spinner {
                    size: 36px;
                }
            }
            Text {
                text: Playback.buffering-percent > 0 ? "Buffering " + Playback.buffering-percent + "%" : "Loading…";
                color: Theme.secondary-text;
                font-size: Theme.font-normal;
                horizontal-alignment: center;
            }
        }

        if root.error != "": Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(460px, parent.width - 40px);
            height: error-text.preferred-height + 28px;
            border-radius: Theme.panel-radius;
            background: Theme.osd-background;
            error-text := Text {
                x: 16px;
                width: parent.width - 32px;
                text: root.error;
                color: Theme.text;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

        // Title bar, faded with the controller like IINA's.
        if Platform.overlay-titlebar && !root.full-screen && !root.pip && !root.music-mode: Rectangle {
            y: 0;
            height: Theme.titlebar-height;
            opacity: root.show-chrome ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: 250ms; }

            TouchArea {
                moved => {
                    root.show-controls();
                }
                changed has-hover => {
                    root.title-hovered = self.has-hover;
                }

                TitleBar {
                    width: parent.width;
                    always-on-top: root.always-on-top;
                    maximized: root.maximized;
                    show-menu(x, y) => {
                        root.open-menu(x, y);
                    }
                    toggle-maximized => {
                        root.maximized = !root.maximized;
                    }
                    minimize => {
                        root.minimized = true;
                    }
                    close => {
                        Actions.patina("close-window");
                    }
                }
            }
        }

        if Prefs.osd-font-size > 0 && !root.music-mode: OsdView {
            x: 14px;
            y: (Platform.overlay-titlebar && !root.full-screen && root.show-chrome ? Theme.titlebar-height : 0px) + 12px;
            animate y { duration: 200ms; }
        }

        // The floating controller.
        osc-area := Rectangle {
            property <length> base-width: min(460px, root.width - 24px);
            width: self.base-width;
            height: 74px;
            x: clamp((root.width - self.width) / 2 + root.osc-offset-x, 8px, max(8px, root.width - self.width - 8px - (root.sidebar-open ? Theme.sidebar-width : 0px)));
            y: clamp(root.height - self.height - 24px + root.osc-offset-y, (Platform.overlay-titlebar ? Theme.titlebar-height : 0px) + 8px, root.height - self.height - 8px);
            opacity: root.show-chrome && Playback.has-media && !root.pip && !root.music-mode ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: 250ms; }

            osc-hover := TouchArea {
                moved => {
                    root.show-controls();
                }

                osc := ControlBar {
                    width: parent.width;
                    fullscreen: root.full-screen;
                    sidebar: root.sidebar-open ? root.sidebar-tab : "";
                    drag(dx, dy) => {
                        root.osc-offset-x += dx;
                        root.osc-offset-y += dy;
                    }
                }
            }

            if osc.seek-hovering && osc.seek-hover-time >= 0 && Playback.duration > 0: SeekPreview {
                time: osc.seek-hover-time;
                x: clamp(osc.seek-hover-x - self.width / 2, 0, parent.width - self.width);
                y: -self.height - 6px;
            }
        }

        // Picture in picture gets IINA's minimal controls instead.
        if root.pip && Playback.has-media: Rectangle {
            opacity: root.show-chrome ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: 200ms; }
            background: @linear-gradient(180deg, #00000060 0%, #00000000 40%, #00000000 60%, #00000080 100%);

            IconButton {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 52px;
                height: 52px;
                icon: Playback.paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                icon-size: 30px;
                tooltip: Playback.paused ? "Play" : "Pause";
                changed has-hover => {
                    root.pip-play-hovered = self.has-hover;
                }
                clicked => {
                    Actions.mpv(["cycle", "pause"]);
                }
            }

            IconButton {
                x: parent.width - self.width - 6px;
                y: 6px;
                icon: @image-url("icons/picture-in-picture-2.svg");
                icon-size: 16px;
                hover-background: true;
                tooltip: "Exit Picture in Picture";
                changed has-hover => {
                    root.pip-exit-hovered = self.has-hover;
                }
                clicked => {
                    Actions.patina("toggle-pip");
                }
            }

            Rectangle {
                x: 10px;
                y: parent.height - 10px;
                width: parent.width - 20px;
                height: 3px;
                border-radius: 1.5px;
                background: Theme.track;
                Rectangle {
                    x: 0;
                    width: Playback.duration > 0 ? parent.width * clamp(Playback.position / Playback.duration, 0, 1) : 0;
                    border-radius: parent.border-radius;
                    background: Theme.track-fill;
                }
            }
        }

        // Music mode: the strip under the cover, and close and back over it,
        // all shown while the pointer is over the cover or the strip.
        if root.music-mode: Rectangle {
            property <bool> hover: video-touch.has-hover || music-panel.hovered || music-buttons.hovered;

            music-panel := MusicPanel {
                x: 0;
                y: root.music-art-height;
                width: parent.width;
                controls: parent.hover;
                volume-shows: root.volume-shows;
                playlist <=> root.sidebar-open;
                art <=> root.music-art;
                mouse-action(action, x, y) => {
                    if action == "context-menu" {
                        root.open-menu(x, self.y + y);
                    } else {
                        root.run-mouse-action(action);
                    }
                }
            }

            // At the right on macOS, clear of its window buttons.
            music-buttons := MusicWindowButtons {
                x: Platform.macos ? parent.width - self.width - 8px : 8px;
                y: 6px;
                compact: root.music-art-height < 40px;
                opacity: parent.hover ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: 200ms; }
            }
        }

        // The sidebar, or in music mode the drawer under the controls.
        sidebar := Sidebar {
            drawer: root.music-mode;
            x: root.music-mode ? 0px : root.width - self.width * root.sidebar-shown;
            y: root.music-mode ? root.music-art-height + 72px : Platform.overlay-titlebar && !root.full-screen ? Theme.titlebar-height : 0px;
            width: root.music-mode ? root.width : Theme.sidebar-width;
            height: root.height - self.y;
            tab <=> root.sidebar-tab;
            visible: root.music-mode ? root.sidebar-open && self.height > 0 : root.sidebar-shown > 0;
            close => {
                root.sidebar-open = false;
            }
        }

        if root.dialog == "open-url" || root.dialog == "add-url": PromptDialog {
            title: root.dialog == "open-url" ? "Open URL" : "Add URL to Playlist";
            message: "A file path, stream, or any site supported by yt-dlp.";
            placeholder: "https://";
            confirm-label: root.dialog == "open-url" ? "Open" : "Add";
            text <=> root.dialog-text;
            cancel => {
                root.dialog = "";
                keys.focus();
            }
            confirm(value) => {
                root.dialog-confirmed(root.dialog, value);
                root.dialog = "";
                keys.focus();
            }
        }

        if root.dialog == "jump-to": PromptDialog {
            title: "Jump To";
            message: "A time such as 1:23:45, 12:30 or 90, or a percentage such as 50%.";
            placeholder: "00:00";
            confirm-label: "Jump";
            text <=> root.dialog-text;
            cancel => {
                root.dialog = "";
                keys.focus();
            }
            confirm(value) => {
                root.dialog-confirmed("jump-to", value);
                root.dialog = "";
                keys.focus();
            }
        }

        // Recent is the newest of the history, so this clears all of it.
        if root.dialog == "clear-recent": ConfirmDialog {
            title: "Clear History";
            message: "Every file goes from Recent and from the History window. Saved playback positions are kept.";
            confirm-label: "Clear";
            cancel => {
                root.dialog = "";
                keys.focus();
            }
            confirm => {
                Actions.patina("clear-recent");
                root.dialog = "";
                keys.focus();
            }
        }

        if root.dialog == "about": AboutDialog {
            cancel => {
                root.dialog = "";
                keys.focus();
            }
        }

        if root.dialog == "shortcuts": ShortcutsDialog {
            shortcuts: root.shortcuts;
            cancel => {
                root.dialog = "";
                keys.focus();
            }
        }

        if root.dialog == "online-subtitles": OnlineSubtitlesDialog {
            cancel => {
                root.dialog = "";
                keys.focus();
            }
        }
    }
}
