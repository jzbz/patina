// The YouTube section, drawn in an idle player window in place of the welcome
// screen and the library. Subscriptions and Watch Later are Patina's own lists,
// and nothing here signs in to anything. Rust's controller (src/youtube/view.rs)
// fills the YouTube global (youtube-model.slint) and answers its callbacks;
// these files only draw.
//
// The view has a bar under Patina's title bar (Back and the pages), a message
// under that when there is one, and below it the page YouTube.page names.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconButton, TextButton, Spinner } from "widgets.slint";
import { YouTube, YouTubeCard, YouTubeChannel, YouTubeLine, YouTubeSight } from "youtube-model.slint";
import { LibraryUi, Avatar, Chip, KeyButton, KeyFocus, Notice, PageField } from "library-parts.slint";
import { DropOverlay } from "library.slint";
import { VideoCard, ChannelRow, SubscribeButton, YouTubeUi } from "youtube-card.slint";

export { YouTube, YouTubeCard, YouTubeChannel, YouTubeLine, YouTubeSight }

// An entry in the bar.
component NavEntry inherits Rectangle {
    in property <string> id;
    in property <string> title;
    in property <int> index;
    property <bool> current: root.id == YouTube.nav-current;

    // As wide as the title in bold, so that the entries beside don't move
    // when this one becomes the current one.
    width: bold.preferred-width + 18px;
    height: 28px;
    border-radius: Theme.control-radius;
    background: root.current ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    accessible-role: tab;
    accessible-label: root.title;
    accessible-item-selectable: true;
    accessible-item-selected: root.current;
    accessible-item-index: root.index;
    accessible-item-count: 5;
    accessible-action-default => {
        YouTubeUi.navigate(root.id);
    }

    bold := Text {
        visible: false;
        text: root.title;
        font-size: Theme.font-normal;
        font-weight: 600;
    }
    Text {
        text: root.title;
        color: root.current || touch.has-hover ? Theme.text : Theme.secondary-text;
        font-size: Theme.font-normal;
        font-weight: root.current ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    KeyFocus {
        reveals: false;
        activated => {
            YouTubeUi.navigate(root.id);
        }
    }

    touch := TouchArea {
        clicked => {
            YouTubeUi.navigate(root.id);
        }
        pointer-event(event) => {
            LibraryUi.pointer(event);
        }
    }
}

// Back, and the pages. The entries scroll sideways if they don't fit, with the
// wheel too, as the library's do.
component YouTubeBar inherits HorizontalLayout {
    height: 32px;
    padding-left: 16px;
    padding-right: 16px;
    spacing: 8px;

    IconButton {
        y: 2px;
        icon: @image-url("icons/chevron-left.svg");
        icon-size: 18px;
        hover-background: true;
        tooltip: YouTube.at-root ? "Back to the Welcome Screen" : "Back";
        clicked => {
            YouTube.back();
        }
    }

    // Where this is, when there is room to say.
    if root.width >= 620px: Text {
        text: "YouTube";
        color: Theme.text;
        font-size: Theme.font-heading;
        font-weight: 700;
        vertical-alignment: center;
    }

    TouchArea {
        horizontal-stretch: 1;
        max-width: entries.preferred-width;
        accessible-role: tab-list;
        accessible-label: "YouTube";
        scroll-event(event) => {
            if event.delta-y != 0 && event.delta-x == 0 && nav.content-width > nav.width {
                nav.content-x = clamp(nav.content-x + event.delta-y, nav.width - nav.content-width, 0px);
                return accept;
            }
            reject
        }

        nav := Flickable {
            width: parent.width;
            height: parent.height;
            content-width: entries.preferred-width;
            content-height: self.height;
            mouse-drag-pan-enabled: false;

            entries := HorizontalLayout {
                width: self.preferred-width;
                height: nav.height;
                padding-top: 2px;
                padding-bottom: 2px;
                spacing: 2px;
                NavEntry {
                    id: "feed";
                    title: "Feed";
                    index: 0;
                }
                NavEntry {
                    id: "search";
                    title: "Search";
                    index: 1;
                }
                NavEntry {
                    id: "saved";
                    title: "Watch Later";
                    index: 2;
                }
                NavEntry {
                    id: "channels";
                    title: "Channels";
                    index: 3;
                }
                NavEntry {
                    id: "history";
                    title: "History";
                    index: 4;
                }
            }
        }
    }

    Rectangle {
        horizontal-stretch: 0.001;
    }
}

// A message under the bar: yt-dlp missing or old, YouTube blocking, how an
// import went, a list that couldn't be read. In a short window it keeps to a
// line, so that the list still has room.
component Banner inherits Rectangle {
    in property <bool> compact;
    property <bool> shows: YouTube.banner != "";
    height: !root.shows ? 0px : root.compact ? 30px : max(30px, words.preferred-height + 14px);
    visible: root.shows;
    border-radius: Theme.control-radius;
    background: #ffffff0d;
    border-width: 1px;
    border-color: Theme.panel-divider;
    accessible-role: text;
    accessible-label: YouTube.banner;

    Image {
        x: 8px;
        y: 8px;
        width: 14px;
        height: 14px;
        source: @image-url("icons/circle-alert.svg");
        colorize: YouTube.banner-dismissable ? Theme.secondary-text : Theme.danger;
    }
    words := Text {
        x: 30px;
        y: root.compact ? 0px : 7px;
        width: root.width - 30px - (YouTube.banner-dismissable ? 32px : 8px);
        height: root.compact ? root.height : self.preferred-height;
        text: YouTube.banner;
        color: Theme.text;
        font-size: Theme.font-normal;
        vertical-alignment: root.compact ? center : top;
        wrap: root.compact ? no-wrap : word-wrap;
        overflow: elide;
        line-height-factor: Theme.paragraph-line-height;
    }
    if YouTube.banner-dismissable: IconButton {
        x: root.width - self.width - 3px;
        y: 3px;
        width: 24px;
        height: 24px;
        icon: @image-url("icons/x.svg");
        icon-size: 14px;
        hover-background: true;
        tooltip: "Dismiss";
        clicked => {
            YouTube.dismiss-banner();
        }
    }
}

// A page's list of lines: videos in as many columns as fit, channels and
// headings. It is a ListView, so that only the lines in sight exist, made anew
// for each page, as a ListView hidden while its model was emptied and filled
// again kept its old layout. What it holds goes under it, for an empty list.
component LineList inherits VerticalLayout {
    property <length> available: root.width - 2 * LibraryUi.inset;
    // Rounded, so that cards stay within about an eighth of their size.
    property <int> columns: max(1, round((root.available + LibraryUi.card-gap) / (LibraryUi.card-width(16 / 9) + LibraryUi.card-gap)));
    property <length> card-width: (root.available - (root.columns - 1) * LibraryUi.card-gap) / root.columns;
    property <length> line-height: root.card-width * 9 / 16 + YouTubeUi.caption-height + 18px;
    // The load (YouTube.loads) the list has gone where scroll-offset says for,
    // and whether it is there now: once it has stayed there a moment, or the
    // user scrolls, it records where it is.
    property <int> settled: -1;
    property <bool> in-place;
    // The times the list was put back where scroll-offset says and moved
    // away again by itself, while it had undone-for lines (see follow()).
    property <int> undone;
    property <int> undone-for: -1;

    init => {
        if root.width > 0 {
            YouTube.layout(root.columns, root.card-width);
        }
    }
    changed columns => {
        if root.width > 0 {
            YouTube.layout(root.columns, root.card-width);
        }
    }
    changed card-width => {
        if root.width > 0 {
            YouTube.layout(root.columns, root.card-width);
        }
    }

    settle-timer := Timer {
        interval: 250ms;
        running: false;
        triggered => {
            self.running = false;
            if root.in-place {
                root.settled = YouTube.loads;
            }
        }
    }

    Rectangle {
        vertical-stretch: 1;
        if YouTube.lines.length > 0: ListView {
            property <int> loads: YouTube.loads;
            property <length> line-height: root.line-height;
            property <int> reveal: LibraryUi.focus-serial;
            function restore() {
                self.content-y = YouTubeUi.place(self.content-height, self.visible-height);
                self.check-place();
            }
            function check-place() {
                root.in-place = YouTubeUi.reached(self.content-y, self.content-height, self.visible-height);
                if root.in-place {
                    settle-timer.restart();
                    settle-timer.running = true;
                }
            }
            // Follows the list as its height or place changes while it goes
            // where scroll-offset says. Moved away by itself (its rows were
            // replaced), it is put back, but only a few times for as many
            // lines: a ListView places itself from the average height of the
            // rows it has made, and as a search's headings, channels and
            // lines of videos differ in height, a different set of rows has
            // another average, and each place it was put moved it on to
            // another. Put back each time, it moved on every frame, made its
            // cards anew under the pointer, so that their menus took no
            // clicks, and restarted the settle-timer before it could fire.
            // Then it stays near the place, until more lines come, a resize,
            // or the user scrolls.
            function follow() {
                if YouTubeUi.placed(self.content-y, self.content-height, self.visible-height) {
                    self.check-place();
                } else {
                    if root.undone-for != YouTube.lines.length {
                        root.undone-for = YouTube.lines.length;
                        root.undone = 0;
                    }
                    if root.undone < 3 {
                        root.undone += 1;
                        self.restore();
                    } else {
                        root.in-place = false;
                    }
                }
            }
            // Tells the controller what of the list is in sight, so that the
            // lines far from it give up their images. It has the heights of
            // the lines below, which it needs to tell which are there: on the
            // Channels page, every line is a channel's, a third as tall as a
            // line of videos, and counting them as videos had pictures stop a
            // third of the way down.
            function report-lines() {
                if root.line-height > 0 {
                    YouTube.lines-shown({
                        top: -self.content-y,
                        bottom: -self.content-y + self.visible-height,
                        videos: root.line-height,
                        heading: YouTubeUi.heading-height,
                        channel: YouTubeUi.channel-height,
                    });
                }
            }
            init => {
                self.restore();
                self.report-lines();
            }
            changed loads => {
                root.undone-for = -1;
                self.restore();
            }
            changed content-height => {
                if root.settled != YouTube.loads {
                    self.follow();
                }
                self.report-lines();
            }
            changed visible-height => {
                if root.settled != YouTube.loads {
                    self.restore();
                }
                self.report-lines();
            }
            changed content-y => {
                if root.settled != YouTube.loads {
                    self.follow();
                } else if self.content-height > 0 {
                    YouTube.scroll-offset = -self.content-y;
                }
                self.report-lines();
            }
            changed line-height => {
                self.report-lines();
            }
            scrolled => {
                root.settled = YouTube.loads;
            }
            // Scrolls what the keyboard moved to into sight.
            changed reveal => {
                let top = LibraryUi.focus-top - self.absolute-position.y;
                let bottom = LibraryUi.focus-bottom - self.absolute-position.y;
                root.settled = YouTube.loads;
                if top < 0 {
                    self.content-y = min(0px, self.content-y - top + 8px);
                } else if bottom > self.visible-height {
                    self.content-y = max(min(0px, self.visible-height - self.content-height), self.content-y - (bottom - self.visible-height) - 8px);
                }
            }

            for line in YouTube.lines: Rectangle {
                height: line.kind == "heading" ? YouTubeUi.heading-height : line.kind == "channel" ? YouTubeUi.channel-height : root.line-height;

                if line.kind == "heading": Text {
                    x: LibraryUi.inset;
                    y: 8px;
                    width: root.available;
                    height: parent.height - 12px;
                    text: line.title;
                    color: Theme.text;
                    font-size: Theme.font-heading;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if line.kind == "channel": ChannelRow {
                    x: LibraryUi.inset - 8px;
                    y: 3px;
                    width: root.available + 16px;
                    channel: line.channel;
                }
                if line.kind == "videos": Rectangle {
                    for card[index] in line.cards: VideoCard {
                        x: LibraryUi.inset + index * (root.card-width + LibraryUi.card-gap);
                        y: 4px;
                        width: root.card-width;
                        card: card;
                    }
                }
            }
        }
        @children
    }
}

// The message for an empty list, with what can be done about it. It scrolls
// when a short window has no room for all of it, so that its buttons can be
// reached.
component EmptyNotice inherits Flickable {
    in property <image> symbol;
    content-height: max(self.height, inner.preferred-height);
    interactive: inner.preferred-height > self.height;

    inner := Notice {
        width: root.width;
        height: root.content-height;
        icon: root.symbol;
        text: YouTube.empty-text;
        if YouTube.empty-offers-channels || YouTube.empty-offers-import: HorizontalLayout {
            alignment: center;
            spacing: 8px;
            if YouTube.empty-offers-channels: KeyButton {
                text: "Add a Channel";
                primary: true;
                clicked => {
                    YouTube.wants-field = true;
                    YouTubeUi.navigate("channels");
                }
            }
            if YouTube.empty-offers-import: KeyButton {
                text: "Import…";
                clicked => {
                    YouTube.import();
                }
            }
        }
    }
}

// The channels' two files, named in the menu, so that which one is written
// never rests on a filter in the dialog. The button looks like Import… beside
// it.
component ExportMenu inherits Rectangle {
    height: 28px;
    min-width: button.min-width;
    preferred-width: button.preferred-width;

    button := KeyButton {
        width: parent.width;
        text: "Export…";
        clicked => {
            menu.show({ x: 0, y: root.height + 4px });
        }
    }

    menu := ContextMenuArea {
        enabled: false;
        Menu {
            MenuItem {
                title: "As in a Google export (CSV)…";
                activated => {
                    YouTube.export("subscriptions");
                }
            }
            MenuItem {
                title: "For NewPipe (JSON)…";
                activated => {
                    YouTube.export("newpipe");
                }
            }
        }
    }
}

// How many are on the list, that it is Patina's own, and its files. The words
// go on a line of their own when they wouldn't fit beside the buttons, except
// in a short window, which needs the room more.
component ListHeader inherits VerticalLayout {
    in property <bool> compact;
    // subscriptions or watch-later
    in property <string> list;
    property <bool> above: root.width < 620px && !root.compact;
    spacing: 4px;

    Text {
        x: LibraryUi.inset;
        width: root.width - 2 * LibraryUi.inset;
        height: root.above ? self.preferred-height : 0px;
        visible: root.above;
        text: YouTube.list-note;
        color: Theme.secondary-text;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }

    HorizontalLayout {
        padding-left: LibraryUi.inset;
        padding-right: LibraryUi.inset;
        spacing: 8px;
        height: 28px;
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.above ? "" : YouTube.list-note;
            color: Theme.secondary-text;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.list == "watch-later" && YouTube.lines.length > 0: KeyButton {
            text: "Play All";
            clicked => {
                YouTube.play-all();
            }
        }
        KeyButton {
            text: "Import…";
            clicked => {
                YouTube.import();
            }
        }
        if root.list == "subscriptions": ExportMenu { }
        if root.list != "subscriptions": KeyButton {
            text: "Export…";
            clicked => {
                YouTube.export(root.list);
            }
        }
    }
}

// Why this page's content didn't come.
component FailedNotice inherits Notice {
    icon: @image-url("icons/circle-alert.svg");
    icon-color: Theme.danger;
    text: YouTube.error;
    HorizontalLayout {
        alignment: center;
        TextButton {
            text: "Try Again";
            clicked => {
                YouTube.retry();
            }
        }
    }
}

// Saved videos at once, with how the last update went above them. New ones
// come in behind that, and nothing here waits for them.
component FeedPage inherits VerticalLayout {
    spacing: 8px;

    HorizontalLayout {
        padding-left: LibraryUi.inset;
        padding-right: LibraryUi.inset - 4px;
        spacing: 8px;
        height: 28px;
        if YouTube.refreshing: VerticalLayout {
            alignment: center;
            Spinner {
                size: 16px;
            }
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: YouTube.status;
            color: Theme.secondary-text;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
        Chip {
            reveals: false;
            text: "Shorts";
            checked: YouTube.show-shorts;
            toggled(value) => {
                YouTube.set-shorts(value);
            }
        }
        IconButton {
            y: 0;
            icon: @image-url("icons/rotate-ccw.svg");
            icon-size: 16px;
            hover-background: true;
            enabled: !YouTube.refreshing;
            tooltip: "Update Now";
            clicked => {
                YouTube.refresh();
            }
        }
    }

    LineList {
        vertical-stretch: 1;
        if YouTube.lines.length == 0 && YouTube.error == "": EmptyNotice {
            symbol: @image-url("icons/list-video.svg");
        }
    }
}

// Searching happens on Enter, never while typing, since each is a process and
// several requests.
component SearchPage inherits VerticalLayout {
    // A dialog over the view has the keyboard.
    in property <bool> covered;
    spacing: 12px;

    // Back from a channel restores the query: typing goes on at its end.
    init => {
        field.take-keyboard();
        field.set-selection-offsets(1000000, 1000000);
    }

    HorizontalLayout {
        padding-left: LibraryUi.inset;
        padding-right: LibraryUi.inset - 4px;
        spacing: 8px;
        field := PageField {
            covered: root.covered;
            horizontal-stretch: 1;
            min-width: 0px;
            max-width: 560px;
            text <=> YouTube.search-text;
            placeholder-text: "Search YouTube, then press Enter";
            // As in the library: Escape, or Backspace with nothing left to
            // delete, goes back.
            key-pressed(event) => {
                if event.text == Key.Escape || (event.text == Key.Backspace && self.text == "") {
                    YouTube.back();
                    return accept;
                }
                reject
            }
            accepted(text) => {
                YouTube.search(text);
                YouTube.scroll-offset = 0;
            }
            edited(text) => {
                YouTube.search-edited(text);
            }
        }
        // Takes what the field's greatest width leaves.
        Rectangle {
            horizontal-stretch: 0.001;
        }
        VerticalLayout {
            alignment: center;
            Chip {
                reveals: false;
                text: "Shorts";
                checked: YouTube.show-shorts;
                toggled(value) => {
                    YouTube.set-shorts(value);
                }
            }
        }
    }

    LineList {
        vertical-stretch: 1;
        if YouTube.lines.length == 0 && !YouTube.loading && YouTube.error == "": EmptyNotice {
            symbol: @image-url("icons/search.svg");
        }
        if YouTube.error != "": FailedNotice { }
    }
}

// Watch Later: Patina's own, which says so.
component SavedPage inherits VerticalLayout {
    in property <bool> compact;
    spacing: 8px;

    ListHeader {
        compact: root.compact;
        list: "watch-later";
    }

    LineList {
        vertical-stretch: 1;
        if YouTube.lines.length == 0: EmptyNotice {
            symbol: @image-url("icons/clock.svg");
        }
    }
}

// What was played from YouTube, newest first, and a way to clear it, which a
// dialog makes sure of first, as the clearing goes further than this page.
component HistoryPage inherits VerticalLayout {
    callback clear;
    spacing: 8px;

    HorizontalLayout {
        padding-left: LibraryUi.inset;
        padding-right: LibraryUi.inset;
        spacing: 8px;
        height: 28px;
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: YouTube.list-note;
            color: Theme.secondary-text;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
        if YouTube.lines.length > 0: KeyButton {
            text: "Clear History…";
            clicked => {
                root.clear();
            }
        }
    }

    LineList {
        vertical-stretch: 1;
        if YouTube.lines.length == 0: EmptyNotice {
            symbol: @image-url("icons/history.svg");
        }
    }
}

// The channels followed, how each last went, and what adds to them.
component ChannelsPage inherits VerticalLayout {
    in property <bool> compact;
    // A dialog over the view has the keyboard, which the field leaves it.
    in property <bool> covered;
    // Nothing needs its field: the view has the keyboard.
    callback focus-view;
    property <bool> adding: YouTube.adding;
    spacing: 8px;

    init => {
        if YouTube.wants-field || YouTube.lines.length == 0 {
            YouTube.wants-field = false;
            field.take-keyboard();
        } else {
            root.focus-view();
        }
    }
    // The field couldn't take the keyboard back from a dialog closed while it
    // was disabled.
    changed adding => {
        if !self.adding && LibraryUi.typing {
            field.take-keyboard();
        }
    }

    HorizontalLayout {
        padding-left: LibraryUi.inset;
        padding-right: LibraryUi.inset;
        spacing: 8px;
        field := PageField {
            horizontal-stretch: 1;
            min-width: 0px;
            max-width: 560px;
            covered: root.covered;
            enabled: !YouTube.adding;
            text <=> YouTube.channel-text;
            placeholder-text: "A channel's link or @handle";
            // As on the Search page.
            key-pressed(event) => {
                if event.text == Key.Escape || (event.text == Key.Backspace && self.text == "") {
                    YouTube.back();
                    return accept;
                }
                reject
            }
            accepted(text) => {
                YouTube.add-channel(text);
            }
        }
        VerticalLayout {
            alignment: center;
            KeyButton {
                text: YouTube.adding ? "Adding…" : "Add";
                primary: true;
                clicked => {
                    if !YouTube.adding {
                        YouTube.add-channel(YouTube.channel-text);
                    }
                }
            }
        }
        // Takes what the field's greatest width leaves, so that the button
        // stays as wide as its word.
        Rectangle {
            horizontal-stretch: 0.001;
        }
    }

    if YouTube.add-message != "": Text {
        x: LibraryUi.inset;
        width: root.width - 2 * LibraryUi.inset;
        text: YouTube.add-message;
        color: Theme.danger;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }

    ListHeader {
        compact: root.compact;
        list: "subscriptions";
    }

    if !root.compact && YouTube.tool-note != "": Text {
        x: LibraryUi.inset;
        width: root.width - 2 * LibraryUi.inset;
        text: YouTube.tool-note;
        color: Theme.tertiary-text;
        font-size: Theme.font-small;
        overflow: elide;
    }

    LineList {
        vertical-stretch: 1;
        if YouTube.lines.length == 0: EmptyNotice {
            symbol: @image-url("icons/user-round.svg");
        }
    }
}

// A channel's newest videos, and whether it is followed.
component ChannelPage inherits VerticalLayout {
    in property <bool> compact;
    spacing: 10px;

    HorizontalLayout {
        padding-left: LibraryUi.inset;
        padding-right: LibraryUi.inset;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Avatar {
                size: root.compact ? 32px : 48px;
                source: YouTube.channel.image;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 1px;
            Text {
                text: YouTube.channel.title;
                color: Theme.text;
                font-size: root.compact ? Theme.font-heading : 22px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: YouTube.channel.detail;
                color: Theme.secondary-text;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            SubscribeButton {
                id: YouTube.channel.id;
                subscribed: YouTube.channel.subscribed;
            }
        }
    }

    // What was saved shows, and why nothing newer came goes above it.
    if YouTube.lines.length > 0 && YouTube.error != "": HorizontalLayout {
        padding-left: LibraryUi.inset;
        padding-right: LibraryUi.inset;
        spacing: 8px;
        height: 28px;
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: YouTube.error;
            color: Theme.danger;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
        KeyButton {
            text: "Try Again";
            clicked => {
                YouTube.retry();
            }
        }
    }

    LineList {
        vertical-stretch: 1;
        if YouTube.lines.length == 0 && !YouTube.loading && YouTube.error == "": EmptyNotice {
            symbol: @image-url("icons/film.svg");
        }
        if YouTube.lines.length == 0 && YouTube.error != "": FailedNotice { }
    }
}

export component YouTubeView inherits Rectangle {
    in property <bool> drop-active;
    // A dialog over the view has the keyboard, which the view leaves it.
    in property <bool> covered;
    // The History page's Clear History…: the window asks first.
    callback clear-history;
    // Where the bar starts: under Patina's title bar, which is drawn over the
    // window's top.
    property <length> bar-top: Theme.titlebar-height + 6px;
    // A window this short keeps its messages to a line and its notes out of
    // the way, or the list would have nowhere to go.
    property <bool> compact: root.height < 380px;
    property <length> content-top: banner.y + (banner.visible ? banner.height : 0px) + 10px;
    property <length> content-height: root.height - root.content-top;
    background: #141416;

    // Takes the keyboard for Backspace (Back), and for Enter, which plays what
    // has the focus and should never reach the window's binding for full
    // screen; every other key goes on to the window's shortcuts. A page with
    // a field to type in focuses it. A page can arrive under a dialog, which
    // keeps the keyboard: the view has it when the dialog closes (see covered).
    function take-focus() {
        LibraryUi.typing = false;
        if !root.covered && !keys.has-focus {
            keys.focus();
        }
    }

    // The Channels page's field is being typed in but is disabled while what
    // was typed is added. What is typed then stops at the view, as it does
    // while signing in to a server, or it would reach the window's shortcuts,
    // where "q" quits.
    property <bool> field-waits: YouTube.page == "channels" && YouTube.adding && LibraryUi.typing;

    // Asked to take the keyboard back (LibraryUi.focus-back): the page's field
    // takes it if it was being typed in, or when it can again.
    property <int> focus-back: LibraryUi.focus-back;
    changed focus-back => {
        if !LibraryUi.typing {
            root.take-focus();
        } else if root.field-waits && !root.covered {
            keys.focus();
        }
    }
    // A dialog's closing gives the keyboard to the window's keys, for the
    // player's sake: here typing would go to the window's shortcuts, where "q"
    // quits, and Backspace and Enter wouldn't stop at the view. This comes
    // after it, as a change's handler runs once the closing has done.
    changed covered => {
        if !self.covered {
            LibraryUi.focus-back += 1;
        }
    }

    // Presses no card or button takes, for the mouse's back button. The
    // pointer coming back to it says a card's menu has closed.
    TouchArea {
        pointer-event(event) => {
            LibraryUi.pointer(event);
        }
        changed has-hover => {
            if self.has-hover {
                LibraryUi.menu-card = "";
            }
        }
    }

    keys := FocusScope {
        focus-on-click: false;
        init => {
            root.take-focus();
        }
        key-pressed(event) => {
            // The keyboard moves on from a field being typed in.
            if event.text == Key.Tab || event.text == Key.Backtab {
                LibraryUi.typing = false;
                return reject;
            }
            if root.field-waits && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && event.text != Key.Escape {
                return accept;
            }
            if event.text == Key.Backspace && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                YouTube.back();
                return accept;
            }
            if event.text == Key.Return {
                return accept;
            }
            reject
        }

        if YouTube.page == "feed": FeedPage {
            y: root.content-top;
            height: root.content-height;
            init => {
                root.take-focus();
            }
        }
        if YouTube.page == "search": SearchPage {
            y: root.content-top;
            height: root.content-height;
            covered: root.covered;
        }
        if YouTube.page == "saved": SavedPage {
            y: root.content-top;
            height: root.content-height;
            compact: root.compact;
            init => {
                root.take-focus();
            }
        }
        if YouTube.page == "channels": ChannelsPage {
            y: root.content-top;
            height: root.content-height;
            compact: root.compact;
            covered: root.covered;
            focus-view => {
                root.take-focus();
            }
        }
        if YouTube.page == "history": HistoryPage {
            y: root.content-top;
            height: root.content-height;
            init => {
                root.take-focus();
            }
            clear => {
                root.clear-history();
            }
        }
        if YouTube.page == "channel": ChannelPage {
            y: root.content-top;
            height: root.content-height;
            compact: root.compact;
            init => {
                root.take-focus();
            }
        }

        // On a plate, since what is loading may draw under it.
        if YouTube.loading: Rectangle {
            x: (root.width - self.width) / 2;
            y: root.content-top + (root.content-height - self.height) / 2;
            width: 56px;
            height: 56px;
            border-radius: Theme.osc-radius;
            background: Theme.osd-background;
            Spinner { }
        }

        YouTubeBar {
            y: root.bar-top;
            width: root.width;
        }

        banner := Banner {
            x: LibraryUi.inset;
            y: root.bar-top + 32px + 8px;
            width: root.width - 2 * LibraryUi.inset;
            compact: root.compact;
        }

        if root.drop-active: DropOverlay { }
    }
}
