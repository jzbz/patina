// Signing in to a Jellyfin server, a step at a time (LibrarySignIn.step):
// its address, then an account, then a password or a Quick Connect code.
// Each step takes the keyboard's focus for its field as it appears.

import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TextButton, Spinner, SectionTitle } from "widgets.slint";
import { Library, LibraryChoice } from "library-model.slint";
import { LibraryUi, Avatar, KeyFocus } from "library-parts.slint";

component Heading inherits Text {
    color: Theme.text;
    font-size: 20px;
    font-weight: 700;
    wrap: word-wrap;
}

component Explanation inherits Text {
    color: Theme.secondary-text;
    font-size: Theme.font-normal;
    wrap: word-wrap;
}

// A line with an icon in front: the error or notice from the controller,
// or the warning about plain http.
component Note inherits HorizontalLayout {
    in property <string> text;
    in property <color> icon-color: Theme.danger;
    spacing: 8px;

    Image {
        y: 1px;
        source: @image-url("icons/circle-alert.svg");
        width: 15px;
        height: 15px;
        colorize: root.icon-color;
    }
    Text {
        horizontal-stretch: 1;
        text: root.text;
        color: Theme.text;
        font-size: Theme.font-normal;
        wrap: word-wrap;
    }
}

// A server found on the network or known already, or an account to sign
// in as. Tab reaches it, and Enter picks it.
component PickRow inherits Rectangle {
    in property <LibraryChoice> choice;
    in property <bool> avatar;
    in property <bool> enabled: true;
    // The one picked: its address is the one filled in.
    in property <bool> selected;
    callback clicked;
    callback double-clicked;

    height: root.choice.detail != "" || root.avatar ? 44px : 32px;
    border-radius: Theme.control-radius;
    background: root.selected ? Theme.selection : touch.pressed ? Theme.pressed : touch.has-hover && root.enabled ? Theme.hover : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.choice.title;
    accessible-description: root.choice.detail;
    accessible-enabled: root.enabled;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    KeyFocus {
        enabled: root.enabled;
        activated => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        if root.avatar: Avatar {
            y: (parent.height - self.height) / 2;
            size: 30px;
        }
        if !root.avatar: Image {
            y: (parent.height - self.height) / 2;
            source: @image-url("icons/server.svg");
            width: 16px;
            height: 16px;
            colorize: Theme.playing;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.choice.title;
                color: root.enabled ? Theme.text : Theme.disabled-text;
                font-size: Theme.font-normal;
                overflow: elide;
            }
            if root.choice.detail != "": Text {
                text: root.choice.detail;
                color: Theme.secondary-text;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
        pointer-event(event) => {
            LibraryUi.pointer(event);
        }
    }
}

// The row of buttons that ends a step, with the spinner while it works.
component Buttons inherits HorizontalLayout {
    spacing: 8px;
    @children
}

component WorkingSpinner inherits VerticalLayout {
    alignment: center;
    visible: Library.sign-in.working;
    Spinner {
        size: 20px;
    }
}

component AddressStep inherits VerticalLayout {
    // The controller fills the address in (from Scan Network, or a server
    // that needs signing in again) after the field was typed in.
    property <string> address: Library.sign-in.address;
    property <bool> busy: Library.sign-in.working;
    spacing: 14px;

    changed address => {
        field.text = self.address;
    }
    init => {
        field.text = root.address;
        field.focus();
    }
    changed busy => {
        if !self.busy {
            field.focus();
        }
    }

    Heading {
        text: "Connect to a Jellyfin Server";
    }
    Explanation {
        text: "Type the server's address, or look for servers on this network.";
    }
    field := LineEdit {
        placeholder-text: "Address, such as 192.168.1.20:8096";
        enabled: !root.busy;
        accepted(text) => {
            if text != "" {
                Library.connect(text);
            }
        }
    }
    if Library.sign-in.message != "": Note {
        text: Library.sign-in.message;
    }
    // As the address is typed, before anything is sent to it.
    if field.text.to-lowercase().starts-with("http://"): Note {
        icon-color: Theme.secondary-text;
        text: "This address uses plain http: your password and what you watch travel unencrypted.";
    }
    Buttons {
        TextButton {
            icon: @image-url("icons/radar.svg");
            text: "Scan Network";
            enabled: !Library.sign-in.scanning && !root.busy;
            accessible-enabled: self.enabled;
            clicked => {
                Library.scan();
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        WorkingSpinner { }
        TextButton {
            text: "Cancel";
            clicked => {
                Library.cancel-sign-in();
            }
        }
        TextButton {
            text: "Connect";
            primary: true;
            enabled: field.text != "" && !root.busy;
            accessible-enabled: self.enabled;
            clicked => {
                Library.connect(field.text);
            }
        }
    }

    // Servers signed in to before, to sign in to again without typing.
    if Library.sign-in.saved.length > 0: VerticalLayout {
        spacing: 4px;
        SectionTitle {
            height: 20px;
            text: "Signed in before";
            vertical-alignment: center;
        }
        for server in Library.sign-in.saved: PickRow {
            choice: server;
            enabled: !root.busy;
            clicked => {
                Library.pick-saved(server.id);
            }
        }
    }

    if Library.sign-in.scanning || Library.sign-in.found.length > 0: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            height: 20px;
            SectionTitle {
                text: Library.sign-in.scanning ? "Looking for servers…" : "On this network";
                vertical-alignment: center;
            }
            if Library.sign-in.scanning: VerticalLayout {
                alignment: center;
                Spinner {
                    size: 14px;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        // A click fills the address in; a double-click connects to it.
        for server in Library.sign-in.found: PickRow {
            choice: server;
            enabled: !root.busy;
            selected: server.id == field.text;
            clicked => {
                Library.pick-server(server.id);
            }
            double-clicked => {
                Library.pick-server(server.id);
                Library.connect(server.id);
            }
        }
    }
}

component UsersStep inherits VerticalLayout {
    property <bool> busy: Library.sign-in.working;
    spacing: 14px;

    // The name field has the keyboard even with accounts listed (one is a
    // click away): someone who signed in before types their name, or their
    // password, expecting a field.
    init => {
        name.focus();
    }

    VerticalLayout {
        spacing: 2px;
        Heading {
            text: Library.sign-in.server-name != "" ? Library.sign-in.server-name : "Sign In";
        }
        Text {
            text: Library.sign-in.server-version != "" ? Library.sign-in.address + " · Jellyfin " + Library.sign-in.server-version : Library.sign-in.address;
            color: Theme.secondary-text;
            font-size: Theme.font-small;
            overflow: elide;
        }
    }

    if Library.sign-in.users.length > 0: VerticalLayout {
        spacing: 2px;
        SectionTitle {
            height: 20px;
            text: "Choose an account";
            vertical-alignment: center;
        }
        for user in Library.sign-in.users: PickRow {
            choice: user;
            avatar: true;
            enabled: !root.busy;
            clicked => {
                Library.pick-user(user.id);
            }
        }
    }

    VerticalLayout {
        spacing: 6px;
        SectionTitle {
            text: Library.sign-in.users.length > 0 ? "Or type a user name" : "User name";
        }
        HorizontalLayout {
            spacing: 8px;
            name := LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "User name";
                enabled: !root.busy;
                accepted(text) => {
                    if text != "" {
                        Library.pick-user(text);
                    }
                }
            }
            TextButton {
                y: (parent.height - self.height) / 2;
                text: "Next";
                enabled: name.text != "" && !root.busy;
                accessible-enabled: self.enabled;
                clicked => {
                    Library.pick-user(name.text);
                }
            }
        }
    }

    if Library.sign-in.message != "": Note {
        text: Library.sign-in.message;
    }
    if Library.sign-in.note != "": Note {
        icon-color: Theme.secondary-text;
        text: Library.sign-in.note;
    }
    if Library.sign-in.insecure: Note {
        icon-color: Theme.secondary-text;
        text: "This server uses plain http: your password and what you watch travel unencrypted.";
    }

    Buttons {
        if Library.sign-in.quick-connect: TextButton {
            text: "Use Quick Connect";
            enabled: !root.busy;
            accessible-enabled: self.enabled;
            clicked => {
                Library.quick-connect();
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        WorkingSpinner { }
        TextButton {
            text: "Cancel";
            clicked => {
                Library.cancel-sign-in();
            }
        }
    }
}

component PasswordStep inherits VerticalLayout {
    property <bool> busy: Library.sign-in.working;
    spacing: 14px;

    property <string> message: Library.sign-in.message;

    init => {
        field.focus();
    }
    // The field is disabled while signing in, which loses its focus.
    changed busy => {
        if !self.busy {
            field.focus();
        }
    }
    // A password refused is selected, so that typing replaces it.
    changed message => {
        if self.message != "" {
            field.focus();
            field.select-all();
        }
    }

    HorizontalLayout {
        spacing: 12px;
        Avatar {
            y: (parent.height - self.height) / 2;
            size: 44px;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: Library.sign-in.user;
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: Library.sign-in.server-name != "" ? Library.sign-in.server-name : Library.sign-in.address;
                color: Theme.secondary-text;
                font-size: Theme.font-normal;
                overflow: elide;
            }
        }
    }

    field := LineEdit {
        input-type: password;
        placeholder-text: "Password";
        enabled: !root.busy;
        accepted(text) => {
            Library.sign-in-with-password(Library.sign-in.user, text);
        }
    }
    if Library.sign-in.message != "": Note {
        text: Library.sign-in.message;
    }
    if Library.sign-in.note != "": Note {
        icon-color: Theme.secondary-text;
        text: Library.sign-in.note;
    }
    if Library.sign-in.insecure: Note {
        icon-color: Theme.secondary-text;
        text: "This server uses plain http: your password and what you watch travel unencrypted.";
    }

    Buttons {
        if Library.sign-in.quick-connect: TextButton {
            text: "Use Quick Connect";
            enabled: !root.busy;
            accessible-enabled: self.enabled;
            clicked => {
                Library.quick-connect();
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        WorkingSpinner { }
        TextButton {
            text: "Cancel";
            clicked => {
                Library.cancel-sign-in();
            }
        }
        TextButton {
            text: "Sign In";
            primary: true;
            enabled: !root.busy;
            accessible-enabled: self.enabled;
            clicked => {
                Library.sign-in-with-password(Library.sign-in.user, field.text);
            }
        }
    }
}

component QuickConnectStep inherits VerticalLayout {
    callback focus-view;
    spacing: 14px;

    init => {
        root.focus-view();
    }

    Heading {
        text: "Quick Connect";
    }
    Explanation {
        text: "In another Jellyfin app that is signed in to " + (Library.sign-in.server-name != "" ? Library.sign-in.server-name : "this server") + ", open Quick Connect and enter this code to approve it.";
    }
    Rectangle {
        height: 76px;
        border-radius: Theme.panel-radius;
        background: Theme.field;
        border-width: 1px;
        border-color: Theme.field-border;
        accessible-role: text;
        accessible-label: "Code " + Library.sign-in.code;
        Text {
            text: Library.sign-in.code;
            color: Theme.text;
            font-size: 38px;
            font-weight: 700;
            letter-spacing: 8px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if Library.sign-in.message != "": Note {
        text: Library.sign-in.message;
    }
    if Library.sign-in.insecure: Note {
        icon-color: Theme.secondary-text;
        text: "This server uses plain http: the sign-in it gives and what you watch travel unencrypted.";
    }
    Buttons {
        VerticalLayout {
            alignment: center;
            Spinner {
                size: 16px;
            }
        }
        Text {
            text: "Waiting for approval…";
            color: Theme.secondary-text;
            font-size: Theme.font-normal;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        TextButton {
            text: "Cancel";
            clicked => {
                Library.cancel-sign-in();
            }
        }
    }
}

export component SignInPage inherits ScrollView {
    // A step without a field to type in hands the keyboard back to the view.
    callback focus-view;
    property <string> step: Library.sign-in.step;
    content-width: self.visible-width;

    // From a top that depends on the view's height only, so that a
    // message appearing grows the card downwards rather than moving it.
    VerticalLayout {
        min-height: root.visible-height;
        alignment: start;
        padding: LibraryUi.inset;
        padding-top: max(12px, (root.visible-height - 420px) / 3);

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(420px, root.visible-width - 2 * LibraryUi.inset);
                border-radius: Theme.panel-radius;
                background: #ffffff08;
                border-width: 1px;
                border-color: Theme.panel-divider;

                VerticalLayout {
                    padding: 24px;
                    if root.step == "address": AddressStep { }
                    if root.step == "users": UsersStep { }
                    if root.step == "password": PasswordStep { }
                    if root.step == "quick-connect": QuickConnectStep {
                        focus-view => {
                            root.focus-view();
                        }
                    }
                }
            }
        }
    }
}
