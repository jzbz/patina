import { MenuPlayback, MenuMedia, Actions } from "globals.slint";

// The application menu, shown from the title bar's menu button and by
// right-clicking the video. It mirrors IINA's main menu.
//
// tools/menubar.py copies the menus into app.slint's macOS menu bar (a
// MenuBar can't be built from a component), so they refer only to globals:
// MenuPlayback and MenuMedia, the state they show, which the copy reads
// from Playback and Media instead (see globals.slint).
export component MainMenu inherits ContextMenuArea {
    Menu {
        Menu {
            title: "File";
            MenuItem {
                title: "Open…";
                activated => {
                    Actions.patina("open-file");
                }
            }
            MenuItem {
                title: "Open URL…";
                activated => {
                    Actions.patina("open-url");
                }
            }
            MenuItem {
                title: "Open Folder…";
                activated => {
                    Actions.patina("open-folder");
                }
            }
            Menu {
                title: "Open Recent";
                for item[index] in MenuMedia.recent: MenuItem {
                    title: item.title;
                    activated => {
                        Actions.open-recent(index);
                    }
                }
                MenuSeparator { }
                MenuItem {
                    title: "Clear Menu";
                    enabled: MenuMedia.recent.length > 0;
                    activated => {
                        Actions.patina("clear-recent");
                    }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Add Files to Playlist…";
                activated => {
                    Actions.patina("add-files");
                }
            }
            MenuItem {
                title: "Save Playlist…";
                enabled: MenuMedia.playlist-count > 0;
                activated => {
                    Actions.patina("save-playlist");
                }
            }
            MenuItem {
                title: "Show in File Manager";
                enabled: MenuPlayback.has-media;
                activated => {
                    Actions.patina("reveal-file");
                }
            }
            MenuItem {
                title: "Move to Trash";
                enabled: MenuPlayback.has-media;
                activated => {
                    Actions.patina("delete-current-file");
                }
            }
            MenuItem {
                title: "Playback History…";
                activated => {
                    Actions.patina("history");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Download Video";
                enabled: MenuMedia.online;
                activated => {
                    Actions.patina("download-video");
                }
            }
            MenuItem {
                title: "Downloads…";
                activated => {
                    Actions.patina("downloads");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Preferences…";
                activated => {
                    Actions.patina("preferences");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "New Window";
                activated => {
                    Actions.patina("new-window");
                }
            }
            MenuItem {
                title: "Close Window";
                activated => {
                    Actions.patina("close-window");
                }
            }
            MenuItem {
                title: "Quit Patina";
                activated => {
                    Actions.patina("quit");
                }
            }
        }

        Menu {
            title: "Playback";
            MenuItem {
                title: MenuPlayback.paused ? "Resume" : "Pause";
                enabled: MenuPlayback.has-media;
                activated => {
                    Actions.mpv(["cycle", "pause"]);
                }
            }
            MenuItem {
                title: "Stop";
                enabled: MenuPlayback.has-media;
                activated => {
                    Actions.mpv(["stop"]);
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Step Forward";
                enabled: MenuPlayback.has-media;
                activated => {
                    Actions.mpv(["frame-step"]);
                }
            }
            MenuItem {
                title: "Step Backward";
                enabled: MenuPlayback.has-media;
                activated => {
                    Actions.mpv(["frame-back-step"]);
                }
            }
            MenuItem {
                title: "Jump Forward 5 s";
                enabled: MenuPlayback.seekable;
                activated => {
                    Actions.mpv(["seek", "5"]);
                }
            }
            MenuItem {
                title: "Jump Backward 5 s";
                enabled: MenuPlayback.seekable;
                activated => {
                    Actions.mpv(["seek", "-5"]);
                }
            }
            MenuItem {
                title: "Jump to Beginning";
                enabled: MenuPlayback.seekable;
                activated => {
                    Actions.mpv(["seek", "0", "absolute"]);
                }
            }
            MenuItem {
                title: "Jump To…";
                enabled: MenuPlayback.seekable;
                activated => {
                    Actions.patina("jump-to");
                }
            }
            MenuSeparator { }
            Menu {
                title: "Speed";
                MenuItem {
                    title: "Speed Up ×2";
                    activated => {
                        Actions.mpv(["multiply", "speed", "2"]);
                    }
                }
                MenuItem {
                    title: "Speed Up 10%";
                    activated => {
                        Actions.mpv(["multiply", "speed", "1.1"]);
                    }
                }
                MenuItem {
                    title: "Slow Down ×0.5";
                    activated => {
                        Actions.mpv(["multiply", "speed", "0.5"]);
                    }
                }
                MenuItem {
                    title: "Slow Down 10%";
                    activated => {
                        Actions.mpv(["multiply", "speed", "0.9091"]);
                    }
                }
                MenuItem {
                    title: "Normal Speed";
                    checked: MenuPlayback.speed == 1;
                    activated => {
                        Actions.set("speed", "1");
                    }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: MenuPlayback.ab-b >= 0 ? "Clear A-B Loop" : MenuPlayback.ab-a >= 0 ? "Set A-B Loop End" : "Set A-B Loop Start";
                enabled: MenuPlayback.seekable;
                activated => {
                    Actions.mpv(["ab-loop"]);
                }
            }
            MenuItem {
                title: "Loop File";
                checked: MenuPlayback.loop-file;
                enabled: MenuPlayback.has-media;
                activated => {
                    Actions.patina("toggle-loop-file");
                }
            }
            MenuItem {
                title: "Loop Playlist";
                checked: MenuPlayback.loop-playlist;
                activated => {
                    Actions.patina("toggle-loop-playlist");
                }
            }
            MenuItem {
                title: "Shuffle";
                checked: MenuPlayback.shuffle;
                activated => {
                    Actions.patina("toggle-shuffle");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Previous Item";
                enabled: MenuMedia.playlist-pos > 0;
                activated => {
                    Actions.mpv(["playlist-prev"]);
                }
            }
            MenuItem {
                title: "Next Item";
                enabled: MenuMedia.playlist-pos >= 0 && MenuMedia.playlist-pos < MenuMedia.playlist-count - 1;
                activated => {
                    Actions.mpv(["playlist-next"]);
                }
            }
            MenuItem {
                title: "Playlist…";
                activated => {
                    Actions.patina("toggle-sidebar playlist");
                }
            }
            Menu {
                title: "Chapters";
                enabled: MenuMedia.chapters.length > 0;
                MenuItem {
                    title: "Previous Chapter";
                    activated => {
                        Actions.mpv(["add", "chapter", "-1"]);
                    }
                }
                MenuItem {
                    title: "Next Chapter";
                    activated => {
                        Actions.mpv(["add", "chapter", "1"]);
                    }
                }
                MenuSeparator { }
                for chapter[index] in MenuMedia.chapters: MenuItem {
                    title: chapter.time-text + "  " + chapter.title;
                    checked: chapter.current;
                    activated => {
                        Actions.select-chapter(index);
                    }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Take Screenshot";
                enabled: MenuPlayback.has-video;
                activated => {
                    Actions.patina("screenshot");
                }
            }
            MenuItem {
                title: "Take Screenshot without Subtitles";
                enabled: MenuPlayback.has-video;
                activated => {
                    Actions.patina("screenshot video");
                }
            }
            MenuItem {
                title: "Open Screenshot Folder";
                activated => {
                    Actions.patina("open-screenshot-folder");
                }
            }
        }

        Menu {
            title: "Video";
            MenuItem {
                title: MenuPlayback.fullscreen ? "Exit Fullscreen" : "Enter Fullscreen";
                activated => {
                    Actions.patina("toggle-fullscreen");
                }
            }
            MenuItem {
                title: "Float on Top";
                checked: MenuPlayback.on-top;
                activated => {
                    Actions.patina("toggle-ontop");
                }
            }
            MenuItem {
                title: "Picture in Picture";
                enabled: MenuPlayback.has-video;
                activated => {
                    Actions.patina("toggle-pip");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Half Size";
                enabled: MenuPlayback.has-video;
                activated => {
                    Actions.patina("window-scale 0.5");
                }
            }
            MenuItem {
                title: "Normal Size";
                enabled: MenuPlayback.has-video;
                activated => {
                    Actions.patina("window-scale 1");
                }
            }
            MenuItem {
                title: "Double Size";
                enabled: MenuPlayback.has-video;
                activated => {
                    Actions.patina("window-scale 2");
                }
            }
            MenuItem {
                title: "Fit to Screen";
                enabled: MenuPlayback.has-video;
                activated => {
                    Actions.patina("fit-to-screen");
                }
            }
            MenuItem {
                title: "Bigger Window";
                enabled: MenuPlayback.has-video;
                activated => {
                    Actions.patina("bigger-window");
                }
            }
            MenuItem {
                title: "Smaller Window";
                enabled: MenuPlayback.has-video;
                activated => {
                    Actions.patina("smaller-window");
                }
            }
            MenuSeparator { }
            Menu {
                title: "Video Track";
                enabled: MenuMedia.video-tracks.length > 0;
                for track in MenuMedia.video-tracks: MenuItem {
                    title: track.title;
                    checked: track.selected;
                    activated => {
                        Actions.select-track("video", track.id);
                    }
                }
            }
            Menu {
                title: "Video Quality";
                enabled: MenuMedia.video-qualities.length > 1;
                for item in MenuMedia.video-qualities: MenuItem {
                    title: item.title;
                    checked: item.selected;
                    activated => {
                        Actions.patina("video-quality " + item.key);
                    }
                }
            }
            Menu {
                title: "Aspect Ratio";
                for label[index] in ["Default", "4:3", "16:9", "16:10", "21:9", "5:4"]: MenuItem {
                    title: label;
                    checked: MenuPlayback.aspect-index == index;
                    activated => {
                        Actions.patina("aspect " + index);
                    }
                }
            }
            Menu {
                title: "Crop";
                for label[index] in ["None", "4:3", "16:9", "16:10", "21:9", "5:4"]: MenuItem {
                    title: label;
                    checked: MenuPlayback.crop-index == index;
                    activated => {
                        Actions.patina("crop " + index);
                    }
                }
            }
            Menu {
                title: "Rotation";
                for degrees in [0, 90, 180, 270]: MenuItem {
                    title: degrees + "°";
                    checked: MenuPlayback.rotation == degrees;
                    activated => {
                        Actions.set("video-rotate", degrees);
                    }
                }
            }
            MenuItem {
                title: "Flip";
                checked: MenuPlayback.flipped;
                activated => {
                    Actions.patina("toggle-flip");
                }
            }
            MenuItem {
                title: "Mirror";
                checked: MenuPlayback.mirrored;
                activated => {
                    Actions.patina("toggle-mirror");
                }
            }
            MenuItem {
                title: "Deinterlace";
                checked: MenuPlayback.deinterlace;
                activated => {
                    Actions.mpv(["cycle", "deinterlace"]);
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Video Settings…";
                activated => {
                    Actions.patina("toggle-sidebar video");
                }
            }
        }

        Menu {
            title: "Audio";
            Menu {
                title: "Audio Track";
                enabled: MenuMedia.audio-tracks.length > 1;
                for track in MenuMedia.audio-tracks: MenuItem {
                    title: track.title;
                    checked: track.selected;
                    activated => {
                        Actions.select-track("audio", track.id);
                    }
                }
            }
            Menu {
                title: "Audio Quality";
                enabled: MenuMedia.audio-qualities.length > 1;
                for item in MenuMedia.audio-qualities: MenuItem {
                    title: item.title;
                    checked: item.selected;
                    activated => {
                        Actions.patina("audio-quality " + item.key);
                    }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Volume Up";
                activated => {
                    Actions.mpv(["add", "volume", "5"]);
                }
            }
            MenuItem {
                title: "Volume Down";
                activated => {
                    Actions.mpv(["add", "volume", "-5"]);
                }
            }
            MenuItem {
                title: "Mute";
                checked: MenuPlayback.muted;
                activated => {
                    Actions.mpv(["cycle", "mute"]);
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Audio Delay +0.5 s";
                activated => {
                    Actions.mpv(["add", "audio-delay", "0.5"]);
                }
            }
            MenuItem {
                title: "Audio Delay −0.5 s";
                activated => {
                    Actions.mpv(["add", "audio-delay", "-0.5"]);
                }
            }
            MenuItem {
                title: "Reset Audio Delay";
                enabled: MenuPlayback.audio-delay != 0;
                activated => {
                    Actions.set("audio-delay", "0");
                }
            }
            MenuSeparator { }
            Menu {
                title: "Audio Device";
                for device in MenuMedia.audio-devices: MenuItem {
                    title: device.description;
                    checked: device.selected;
                    activated => {
                        Actions.set("audio-device", device.name);
                    }
                }
            }
            MenuItem {
                title: "Load External Audio…";
                enabled: MenuPlayback.has-media;
                activated => {
                    Actions.patina("load-audio");
                }
            }
            MenuItem {
                title: "Audio Settings…";
                activated => {
                    Actions.patina("toggle-sidebar audio");
                }
            }
        }

        Menu {
            title: "Subtitles";
            Menu {
                title: "Subtitle";
                enabled: MenuPlayback.has-media;
                for track in MenuMedia.sub-tracks: MenuItem {
                    title: track.title;
                    checked: track.selected;
                    activated => {
                        Actions.select-track("sub", track.id);
                    }
                }
            }
            Menu {
                title: "Secondary Subtitle";
                enabled: MenuPlayback.has-media;
                for track in MenuMedia.secondary-sub-tracks: MenuItem {
                    title: track.title;
                    checked: track.selected;
                    activated => {
                        Actions.select-secondary-sub(track.id);
                    }
                }
            }
            MenuItem {
                title: "Load External Subtitle…";
                enabled: MenuPlayback.has-media;
                activated => {
                    Actions.patina("load-subtitles");
                }
            }
            MenuItem {
                title: "Find Online Subtitles…";
                enabled: MenuPlayback.has-media;
                activated => {
                    Actions.patina("find-online-subtitles");
                }
            }
            MenuItem {
                title: "Save Downloaded Subtitle…";
                enabled: MenuMedia.downloaded-subtitle;
                activated => {
                    Actions.patina("save-downloaded-subtitle");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Show Subtitles";
                checked: MenuPlayback.sub-visible;
                activated => {
                    Actions.mpv(["cycle", "sub-visibility"]);
                }
            }
            MenuItem {
                title: "Delay +0.5 s";
                activated => {
                    Actions.mpv(["add", "sub-delay", "0.5"]);
                }
            }
            MenuItem {
                title: "Delay −0.5 s";
                activated => {
                    Actions.mpv(["add", "sub-delay", "-0.5"]);
                }
            }
            MenuItem {
                title: "Reset Delay";
                enabled: MenuPlayback.sub-delay != 0;
                activated => {
                    Actions.set("sub-delay", "0");
                }
            }
            MenuItem {
                title: "Bigger";
                activated => {
                    Actions.mpv(["add", "sub-scale", "0.1"]);
                }
            }
            MenuItem {
                title: "Smaller";
                activated => {
                    Actions.mpv(["add", "sub-scale", "-0.1"]);
                }
            }
            MenuItem {
                title: "Reset Size";
                enabled: MenuPlayback.sub-scale != 1;
                activated => {
                    Actions.set("sub-scale", "1");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Subtitle Settings…";
                activated => {
                    Actions.patina("toggle-sidebar subtitles");
                }
            }
        }

        Menu {
            title: "Window";
            MenuItem {
                title: "Minimize";
                activated => {
                    Actions.patina("minimize");
                }
            }
            MenuItem {
                title: "Playlist";
                activated => {
                    Actions.patina("toggle-sidebar playlist");
                }
            }
            MenuItem {
                title: "Chapters";
                activated => {
                    Actions.patina("toggle-sidebar chapters");
                }
            }
            MenuItem {
                title: "Quick Settings";
                activated => {
                    Actions.patina("toggle-sidebar video");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Inspector";
                activated => {
                    Actions.patina("inspector");
                }
            }
            MenuItem {
                title: "Playback History";
                activated => {
                    Actions.patina("history");
                }
            }
        }

        Menu {
            title: "Help";
            MenuItem {
                title: "Keyboard Shortcuts";
                activated => {
                    Actions.patina("show-shortcuts");
                }
            }
            MenuItem {
                title: "Patina Website";
                activated => {
                    Actions.patina("open-website");
                }
            }
            MenuItem {
                title: "About Patina";
                activated => {
                    Actions.patina("about");
                }
            }
        }
    }
}
