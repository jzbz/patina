import { Theme } from "theme.slint";
import { Playback, Prefs, Actions, Osd, Platform } from "globals.slint";
import { IconButton, Slider, SeekBar, Format } from "widgets.slint";

component ToolbarButton inherits IconButton {
    in property <string> kind;
    in property <bool> fullscreen;
    in property <string> sidebar;
    icon: root.kind == "pip" ? @image-url("icons/picture-in-picture-2.svg")
        : root.kind == "playlist" ? @image-url("icons/list-video.svg")
        : root.kind == "settings" ? @image-url("icons/sliders-horizontal.svg")
        : root.kind == "fullscreen" ? (root.fullscreen ? @image-url("icons/minimize.svg") : @image-url("icons/maximize.svg"))
        : root.kind == "music" ? @image-url("icons/music.svg")
        : root.kind == "screenshot" ? @image-url("icons/camera.svg")
        : root.kind == "subtitles" ? @image-url("icons/captions.svg")
        : @image-url("icons/ellipsis.svg");
    tooltip: root.kind == "pip" ? "Picture in Picture"
        : root.kind == "playlist" ? "Playlist"
        : root.kind == "settings" ? "Quick Settings"
        : root.kind == "fullscreen" ? "Fullscreen"
        : root.kind == "music" ? "Music Mode"
        : root.kind == "screenshot" ? "Screenshot"
        : root.kind == "subtitles" ? "Subtitles"
        : root.kind;
    active: (root.kind == "playlist" && (root.sidebar == "playlist" || root.sidebar == "chapters" || root.sidebar == "lyrics"))
        || (root.kind == "settings" && (root.sidebar == "video" || root.sidebar == "audio"))
        || (root.kind == "subtitles" && root.sidebar == "subtitles");
    icon-size: 17px;
    width: 24px;
}

// The floating on-screen controller.
export component ControlBar inherits Rectangle {
    in property <bool> fullscreen;
    in property <string> sidebar;
    out property <bool> seek-hovering: seek.hovering || seek.dragging;
    out property <length> seek-hover-x: seek.x + seek.hover-x;
    out property <float> seek-hover-time: seek.dragging ? -1 : seek.hover-time;
    // Drag the bar around; the parent moves it.
    callback drag(length, length);

    property <image> volume-icon: Playback.muted || Playback.volume <= 0 ? @image-url("icons/volume-x.svg")
        : Playback.volume < 34 ? @image-url("icons/volume.svg")
        : Playback.volume < 67 ? @image-url("icons/volume-1.svg")
        : @image-url("icons/volume-2.svg");

    width: 460px;
    height: 74px;
    border-radius: Theme.osc-radius;
    background: Theme.osc-background;
    border-width: 1px;
    border-color: Theme.osc-border;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000059;

    // Background: dragging it moves the bar, as in IINA.
    TouchArea {
        mouse-cursor: self.pressed ? grabbing : default;
        moved => {
            if self.pressed {
                root.drag(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }

    // Top row: volume, transport, toolbar.
    IconButton {
        x: 12px;
        y: 8px;
        icon: root.volume-icon;
        icon-size: 18px;
        tooltip: Playback.muted ? "Unmute" : "Mute";
        clicked => {
            Actions.mpv(["cycle", "mute"]);
        }
    }

    Slider {
        x: 42px;
        y: 14px;
        width: 76px;
        knob-size: 12px;
        value: Playback.volume;
        maximum: Playback.volume-max;
        scroll-step: 2;
        changed(value) => {
            Actions.set("volume", round(value));
        }
    }

    Rectangle {
        x: (root.width - self.width) / 2;
        y: 4px;
        width: 150px;
        height: 36px;

        rewind := IconButton {
            x: 6px;
            y: 4px;
            width: 34px;
            icon: Prefs.arrow-action == "playlist" ? @image-url("icons/skip-back.svg") : @image-url("icons/rewind.svg");
            icon-size: 22px;
            enabled: Playback.has-media;
            tooltip: Prefs.arrow-action == "speed" ? "Slow down" : Prefs.arrow-action == "seek" ? "Back 10 seconds" : "Previous";
            clicked => {
                Actions.patina("osc-left");
            }
        }

        IconButton {
            x: (parent.width - self.width) / 2;
            y: 0;
            width: 40px;
            height: 36px;
            icon: Playback.paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
            icon-size: 26px;
            enabled: Playback.has-media;
            tooltip: Playback.paused ? "Play" : "Pause";
            clicked => {
                Actions.mpv(["cycle", "pause"]);
            }
        }

        IconButton {
            x: parent.width - self.width - 6px;
            y: 4px;
            width: 34px;
            icon: Prefs.arrow-action == "playlist" ? @image-url("icons/skip-forward.svg") : @image-url("icons/fast-forward.svg");
            icon-size: 22px;
            enabled: Playback.has-media;
            tooltip: Prefs.arrow-action == "speed" ? "Speed up" : Prefs.arrow-action == "seek" ? "Forward 10 seconds" : "Next";
            clicked => {
                Actions.patina("osc-right");
            }
        }

        // IINA shows the current speed beside the button that changed it.
        if Prefs.arrow-action == "speed" && Playback.speed != 1: Text {
            x: Playback.speed < 1 ? -self.width + 6px : parent.width - 6px;
            y: 12px;
            text: (round(Playback.speed * 100) / 100) + "×";
            color: Theme.secondary-text;
            font-size: 10px;
        }
    }

    toolbar := HorizontalLayout {
        x: root.width - self.width - 10px;
        y: 8px;
        width: self.preferred-width;
        height: 28px;
        spacing: 2px;
        for kind in Prefs.toolbar-buttons: ToolbarButton {
            kind: kind;
            fullscreen: root.fullscreen;
            sidebar: root.sidebar;
            clicked => {
                Actions.patina("toolbar " + kind);
            }
        }
    }

    // Bottom row: elapsed time, seek bar, duration or remaining time. The
    // times' boxes fit "-10:00:00" in IBM Plex Sans at this size.
    Text {
        x: 8px;
        y: 44px;
        width: 58px;
        height: 18px;
        text: Format.time(seek.dragging ? seek.hover-time : Playback.position);
        color: Theme.secondary-text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    seek := SeekBar {
        x: 70px;
        y: 44px;
        width: root.width - 140px;
        position: Playback.position;
        duration: Playback.duration;
        cache-end: Playback.cache-end;
        enabled: Playback.seekable;
        chapters: Playback.chapter-marks;
        show-chapters: Prefs.show-chapter-marks;
        ab-a: Playback.ab-a;
        ab-b: Playback.ab-b;
        seek(time, exact) => {
            Actions.seek(time, exact);
        }
    }

    Text {
        x: root.width - 66px;
        y: 44px;
        width: 58px;
        height: 18px;
        text: Playback.duration <= 0 ? "--:--" : Prefs.show-remaining-time ? "-" + Format.time(Playback.duration - Playback.position) : Format.time(Playback.duration);
        color: Theme.secondary-text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;

        TouchArea {
            clicked => {
                Prefs.show-remaining-time = !Prefs.show-remaining-time;
                Actions.patina("save-ui-prefs");
            }
        }
    }
}

// IINA's seek preview: the thumbnail at the hovered time (once made), the
// time, and the chapter there.
export component SeekPreview inherits Rectangle {
    in property <float> time;
    width: layout.preferred-width;
    height: layout.preferred-height;
    border-radius: 6px;
    background: Theme.osd-background;
    border-width: 1px;
    border-color: Theme.osc-border;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000066;

    init => {
        Actions.preview(root.time);
    }
    changed time => {
        Actions.preview(root.time);
    }

    layout := VerticalLayout {
        padding: 3px;
        padding-bottom: 4px;
        spacing: 2px;

        if Playback.preview-ready: Rectangle {
            width: Prefs.thumbnail-width;
            height: self.width * Playback.preview-image.height / max(1, Playback.preview-image.width);
            border-radius: 4px;
            clip: true;
            Image {
                source: Playback.preview-image;
                width: parent.width;
                height: parent.height;
                image-fit: fill;
            }
        }
        Text {
            text: Format.time(root.time);
            color: Theme.text;
            font-size: 12px;
            horizontal-alignment: center;
            min-width: 44px;
        }
        if Playback.preview-chapter != "": Text {
            text: Playback.preview-chapter;
            color: Theme.secondary-text;
            font-size: 10px;
            horizontal-alignment: center;
            overflow: elide;
            max-width: Prefs.thumbnail-width;
        }
    }
}

// Skip Intro (Credits, Recap...) over the video, while a Jellyfin item's
// segment that the server marks plays. Tab reaches it while it shows, and
// Enter or Space presses it; other keys go on to the player. It takes no
// focus on a click, so that the ring shows only for the keyboard.
export component SkipButton inherits Rectangle {
    in property <string> text;
    // The key bound to it, shown beside its words.
    in property <string> key;
    in property <bool> shown;
    out property <bool> has-focus: scope.has-focus;
    // The words shown last, which stay while the button fades out.
    property <string> words: root.text;
    callback clicked;

    changed text => {
        if root.text != "" {
            root.words = root.text;
        }
    }

    width: layout.preferred-width;
    height: 36px;
    border-radius: Theme.panel-radius;
    background: touch.pressed ? #3a3a3cf2 : touch.has-hover ? #2e2e30f0 : Theme.osc-background;
    border-width: scope.has-focus ? 2px : 1px;
    border-color: scope.has-focus ? Theme.accent : Theme.osc-border;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000066;
    opacity: root.shown ? 1 : 0;
    visible: self.opacity > 0;
    animate opacity { duration: 200ms; }
    accessible-role: button;
    accessible-label: root.key != "" ? root.words + " (" + root.key + ")" : root.words;
    accessible-enabled: root.shown;
    accessible-action-default => {
        root.clicked();
    }

    scope := FocusScope {
        enabled: root.shown;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    layout := HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;
        Text {
            text: root.words;
            color: Theme.text;
            font-size: Theme.font-normal;
            font-weight: 600;
            vertical-alignment: center;
        }
        if root.key != "": Text {
            text: root.key;
            color: Theme.secondary-text;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        Image {
            source: @image-url("icons/skip-forward.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: touch.has-hover ? Theme.icon-hover : Theme.icon;
        }
    }

    touch := TouchArea {
        enabled: root.shown;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component WindowButton inherits Rectangle {
    in property <image> icon;
    in property <bool> danger;
    in property <string> tooltip;
    callback clicked;
    width: 40px;
    height: Theme.titlebar-height;
    background: touch.has-hover ? (root.danger ? Theme.close-hover : Theme.hover) : transparent;
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-action-default => {
        root.clicked();
    }

    Image {
        source: root.icon;
        width: 14px;
        colorize: touch.has-hover ? white : Theme.icon;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The title bar shown over the video, hidden together with the controller.
export component TitleBar inherits Rectangle {
    in property <bool> always-on-top;
    in property <bool> maximized;
    // The library or the YouTube section shows, which Home leaves for the
    // welcome screen. Nothing plays then: a file has neither on screen.
    in property <bool> can-go-home;
    callback show-menu(length, length);
    callback toggle-maximized;
    callback minimize;
    callback close;

    height: Theme.titlebar-height;
    background: Theme.titlebar-background;

    WindowMoveArea {
        TouchArea {
            double-clicked => {
                root.toggle-maximized();
            }
        }

        HorizontalLayout {
            padding-left: Platform.macos ? 76px : 4px;
            spacing: 6px;

            if !Platform.macos: menu-button := IconButton {
                y: 2px;
                icon: @image-url("icons/menu.svg");
                icon-size: 16px;
                hover-background: true;
                tooltip: "Menu";
                clicked => {
                    root.show-menu(self.x, self.y + self.height + 4px);
                }
            }

            Image {
                source: @image-url("icons/file-play.svg");
                width: 15px;
                colorize: #8cb4ff;
                visible: Playback.has-media;
            }

            Text {
                text: Playback.has-media ? Playback.title : "Patina";
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if root.can-go-home: IconButton {
                y: 2px;
                icon: @image-url("icons/house.svg");
                icon-size: 16px;
                hover-background: true;
                tooltip: "Welcome Screen";
                clicked => {
                    Actions.patina("welcome");
                }
            }

            IconButton {
                y: 2px;
                icon: @image-url("icons/picture-in-picture-2.svg");
                icon-size: 16px;
                hover-background: true;
                tooltip: "Picture in Picture";
                enabled: Playback.has-video;
                clicked => {
                    Actions.patina("toggle-pip");
                }
            }

            if Platform.can-float: IconButton {
                y: 2px;
                icon: root.always-on-top ? @image-url("icons/pin-filled.svg") : @image-url("icons/pin.svg");
                icon-size: 16px;
                hover-background: true;
                active: root.always-on-top;
                tooltip: root.always-on-top ? "Don't Float on Top" : "Float on Top";
                clicked => {
                    Actions.patina("toggle-ontop");
                }
            }

            if Platform.custom-titlebar: HorizontalLayout {
                padding-left: 4px;
                WindowButton {
                    icon: @image-url("icons/minus.svg");
                    tooltip: "Minimize";
                    clicked => {
                        root.minimize();
                    }
                }
                WindowButton {
                    icon: root.maximized ? @image-url("icons/copy.svg") : @image-url("icons/square.svg");
                    tooltip: root.maximized ? "Restore" : "Maximize";
                    clicked => {
                        root.toggle-maximized();
                    }
                }
                WindowButton {
                    icon: @image-url("icons/x.svg");
                    danger: true;
                    tooltip: "Close";
                    clicked => {
                        root.close();
                    }
                }
            }
        }
    }
}

// On-screen display messages, shown in the top-left corner.
export component OsdView inherits Rectangle {
    width: min(layout.preferred-width, 420px);
    height: layout.preferred-height;
    border-radius: 8px;
    background: Theme.osd-background;
    border-width: 1px;
    border-color: Theme.osc-border;
    opacity: Osd.visible ? 1 : 0;
    animate opacity { duration: Osd.visible ? 80ms : 300ms; }

    layout := VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 9px;
        spacing: 5px;

        Text {
            text: Osd.text;
            color: Theme.text;
            font-size: Prefs.osd-font-size;
            overflow: elide;
        }

        if Osd.detail != "": Text {
            text: Osd.detail;
            color: Theme.secondary-text;
            font-size: Prefs.osd-font-size * 0.6;
            overflow: elide;
        }

        if Osd.progress >= 0: Rectangle {
            height: 5px;
            min-width: 180px;
            border-radius: 2.5px;
            background: Theme.track;

            Rectangle {
                x: 0;
                width: parent.width * clamp(Osd.progress, 0, 1);
                border-radius: parent.border-radius;
                background: Theme.track-fill;
            }
        }
    }
}
