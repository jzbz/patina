import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Playback, Media, Actions, PlaylistItem, TrackItem } from "globals.slint";
import { IconButton, TextButton, Segmented, Switch, SettingRow, SectionTitle, ValueSlider, ChoiceRow, Slider, Format } from "widgets.slint";

component PanelSection inherits VerticalLayout {
    in property <string> title;
    spacing: 6px;
    if root.title != "": SectionTitle {
        text: root.title;
    }
    @children
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.panel-divider;
}

// A playlist entry. Drag it to move it; the panel draws where it will land.
component PlaylistRow inherits Rectangle {
    in property <PlaylistItem> item;
    in property <int> index;
    in property <int> count;
    // Where a dragged entry would be inserted, or -1.
    in property <int> drop-position: -1;
    in property <bool> dragged;
    // Whether the series prefix is shown in full.
    in property <bool> expanded;
    callback drag-to(int);
    callback drop(int);
    callback pressed;
    callback menu(length, length);
    callback expand;

    property <bool> dragging;
    // The insertion point under the pointer: rows swap halfway across.
    property <int> target: clamp(root.index + floor(touch.mouse-y / root.height + 0.5), 0, root.count);

    height: 44px;
    border-radius: Theme.control-radius;
    background: root.item.selected ? Theme.selection : touch.has-hover && !root.dragging ? Theme.hover : transparent;
    opacity: root.dragged ? 0.45 : 1;

    touch := TouchArea {
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.default;
        double-clicked => {
            Actions.play-index(root.index);
        }
        moved => {
            if !root.dragging && abs(self.mouse-y - self.pressed-y) > 5px {
                root.dragging = true;
            }
            if root.dragging {
                root.drag-to(root.target);
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.pressed();
                Actions.select-playlist(root.index, event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
            } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.pressed();
                Actions.playlist-menu(root.index);
                root.menu(self.mouse-x, self.mouse-y);
            } else if event.kind == PointerEventKind.up && root.dragging {
                root.dragging = false;
                root.drop(root.target);
            } else if event.kind == PointerEventKind.cancel && root.dragging {
                root.dragging = false;
                root.drop(-1);
            }
        }
    }

    if root.drop-position == root.index: Rectangle {
        y: 0;
        height: 2px;
        background: Theme.accent;
    }
    if root.drop-position == root.count && root.index == root.count - 1: Rectangle {
        y: root.height - 2px;
        height: 2px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 8px;

        Rectangle {
            width: 18px;
            if root.item.current: Image {
                source: Playback.paused ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                width: 11px;
                colorize: Theme.playing;
            }
            if !root.item.current: Text {
                text: root.index + 1;
                color: Theme.tertiary-text;
                font-size: Theme.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            if root.item.short-title == "" || root.expanded: Text {
                text: root.item.title;
                color: root.item.current ? Theme.playing : Theme.text;
                font-size: Theme.font-normal;
                font-weight: root.item.current ? 600 : 400;
                overflow: elide;
            }
            // The series prefix it shares with its neighbours, folded into
            // a "…" that shows it again, as in IINA.
            if root.item.short-title != "" && !root.expanded: HorizontalLayout {
                spacing: 2px;
                Rectangle {
                    width: ellipsis.preferred-width + 6px;
                    border-radius: 3px;
                    background: fold-touch.has-hover ? Theme.hover : transparent;
                    ellipsis := Text {
                        text: "…";
                        color: Theme.secondary-text;
                        font-size: Theme.font-normal;
                    }
                    fold-touch := TouchArea {
                        clicked => {
                            root.expand();
                        }
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.item.short-title;
                    color: root.item.current ? Theme.playing : Theme.text;
                    font-size: Theme.font-normal;
                    font-weight: root.item.current ? 600 : 400;
                    overflow: elide;
                }
            }
            if root.item.detail != "": Text {
                text: root.item.detail;
                color: Theme.tertiary-text;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }

        if !touch.has-hover && !remove.has-hover: Text {
            text: root.item.duration;
            color: Theme.secondary-text;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }

        remove := IconButton {
            y: 10px;
            width: (touch.has-hover || self.has-hover) && !root.dragging ? 24px : 0px;
            height: 24px;
            visible: self.width > 0;
            icon: @image-url("icons/x.svg");
            icon-size: 12px;
            tooltip: "Remove from playlist";
            clicked => {
                Actions.remove-index(root.index);
            }
        }
    }

    // How far the entry was watched, as in IINA.
    if root.item.progress > 0: Rectangle {
        x: 34px;
        y: root.height - 4px;
        width: (root.width - 44px) * min(1, root.item.progress);
        height: 2px;
        border-radius: 1px;
        background: Theme.playing.with-alpha(0.7);
    }
}

component PlaylistPanel inherits VerticalLayout {
    property <int> drag-from: -1;
    property <int> drop-position: -1;
    property <bool> expanded;
    spacing: 8px;

    HorizontalLayout {
        spacing: 4px;
        Text {
            text: Media.playlist-summary;
            color: Theme.secondary-text;
            font-size: Theme.font-small;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        IconButton {
            icon: @image-url("icons/repeat-1.svg");
            icon-size: 16px;
            active: Playback.loop-file;
            tooltip: "Loop File";
            clicked => {
                Actions.patina("toggle-loop-file");
            }
        }
        IconButton {
            icon: @image-url("icons/repeat.svg");
            icon-size: 16px;
            active: Playback.loop-playlist;
            tooltip: "Loop Playlist";
            clicked => {
                Actions.patina("toggle-loop-playlist");
            }
        }
        IconButton {
            icon: @image-url("icons/shuffle.svg");
            icon-size: 16px;
            active: Playback.shuffle;
            tooltip: "Shuffle";
            clicked => {
                Actions.patina("toggle-shuffle");
            }
        }
    }

    if Media.playlist.length == 0: Rectangle {
        vertical-stretch: 1;
        Text {
            text: "The playlist is empty.\nDrop files here or add some below.";
            color: Theme.tertiary-text;
            font-size: Theme.font-normal;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if Media.playlist.length > 0: menu := ContextMenuArea {
        vertical-stretch: 1;
        enabled: false;

        Menu {
            MenuItem {
                title: "Play Next";
                activated => {
                    Actions.patina("playlist-play-next");
                }
            }
            MenuItem {
                title: "Play in New Window";
                activated => {
                    Actions.patina("playlist-play-new-window");
                }
            }
            MenuItem {
                title: Media.playlist-selected > 1 ? "Remove " + Media.playlist-selected + " Items" : "Remove";
                activated => {
                    Actions.patina("playlist-remove");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Cut";
                activated => {
                    Actions.patina("playlist-cut");
                }
            }
            MenuItem {
                title: Media.selection-urls && !Media.selection-local ? "Copy URL" : "Copy";
                activated => {
                    Actions.patina("playlist-copy");
                }
            }
            MenuItem {
                title: "Paste";
                activated => {
                    Actions.patina("playlist-paste");
                }
            }
            if Media.selection-subtitles: MenuSeparator { }
            if Media.selection-subtitles: MenuItem {
                title: "Add Subtitle…";
                activated => {
                    Actions.patina("playlist-add-subtitle");
                }
            }
            if Media.selection-subtitles: MenuItem {
                title: Media.wrong-subtitle ? "Use Matched Subtitles" : "Wrong Subtitle";
                activated => {
                    Actions.patina("playlist-wrong-subtitle");
                }
            }
            if Media.selection-urls: MenuSeparator { }
            if Media.selection-urls: MenuItem {
                title: "Open in Browser";
                activated => {
                    Actions.patina("playlist-open-in-browser");
                }
            }
            if Media.selection-local: MenuSeparator { }
            if Media.selection-local: MenuItem {
                title: "Show in File Manager";
                activated => {
                    Actions.patina("playlist-reveal");
                }
            }
            if Media.selection-local: MenuItem {
                title: "Move to Trash";
                activated => {
                    Actions.patina("playlist-trash");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Add Files…";
                activated => {
                    Actions.patina("add-files");
                }
            }
            MenuItem {
                title: "Add URL…";
                activated => {
                    Actions.patina("add-url");
                }
            }
            MenuItem {
                title: "Clear Playlist";
                activated => {
                    Actions.patina("clear-playlist");
                }
            }
        }

        // Keys for the selection once a row has been clicked; the rest go on
        // to the player's bindings.
        list-keys := FocusScope {
            key-pressed(event) => {
                let command = event.modifiers.control || event.modifiers.meta;
                if (event.text == Key.Delete || event.text == Key.Backspace) && Media.playlist-selected > 0 {
                    Actions.patina("playlist-remove");
                    return accept;
                }
                if event.text == Key.Return && Media.playlist-selected > 0 {
                    Actions.patina("playlist-play-selected");
                    return accept;
                }
                if command && event.text == "a" {
                    Actions.patina("playlist-select-all");
                    return accept;
                }
                if command && event.text == "c" && Media.playlist-selected > 0 {
                    Actions.patina("playlist-copy");
                    return accept;
                }
                if command && event.text == "x" && Media.playlist-selected > 0 {
                    Actions.patina("playlist-cut");
                    return accept;
                }
                if command && event.text == "v" {
                    Actions.patina("playlist-paste");
                    return accept;
                }
                reject
            }

            ListView {
                for item[index] in Media.playlist: PlaylistRow {
                    item: item;
                    index: index;
                    count: Media.playlist.length;
                    drop-position: root.drop-position;
                    dragged: root.drag-from == index;
                    expanded: root.expanded;
                    pressed => {
                        list-keys.focus();
                    }
                    menu(x, y) => {
                        menu.show({
                            x: self.absolute-position.x - menu.absolute-position.x + x,
                            y: self.absolute-position.y - menu.absolute-position.y + y,
                        });
                    }
                    expand => {
                        root.expanded = true;
                    }
                    drag-to(position) => {
                        root.drag-from = index;
                        root.drop-position = position;
                    }
                    drop(position) => {
                        // mpv inserts the moved entry before `position`.
                        if position >= 0 && position != index && position != index + 1 {
                            Actions.move-index(index, position);
                        }
                        root.drag-from = -1;
                        root.drop-position = -1;
                    }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 6px;
        TextButton {
            text: "Add Files…";
            icon: @image-url("icons/plus.svg");
            clicked => {
                Actions.patina("add-files");
            }
        }
        TextButton {
            text: "URL…";
            icon: @image-url("icons/link.svg");
            clicked => {
                Actions.patina("add-url");
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        TextButton {
            text: "Clear";
            icon: @image-url("icons/trash-2.svg");
            enabled: Media.playlist.length > 0;
            clicked => {
                Actions.patina("clear-playlist");
            }
        }
    }
}

component ChaptersPanel inherits VerticalLayout {
    spacing: 8px;

    if Media.chapters.length == 0: Rectangle {
        vertical-stretch: 1;
        Text {
            text: "No chapters";
            color: Theme.tertiary-text;
            font-size: Theme.font-normal;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if Media.chapters.length > 0: ListView {
        vertical-stretch: 1;
        for chapter[index] in Media.chapters: Rectangle {
            height: 34px;
            border-radius: Theme.control-radius;
            background: chapter.current ? Theme.selection : touch.has-hover ? Theme.hover : transparent;

            touch := TouchArea {
                clicked => {
                    Actions.select-chapter(index);
                }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                Text {
                    text: chapter.title;
                    color: chapter.current ? Theme.playing : Theme.text;
                    font-size: Theme.font-normal;
                    font-weight: chapter.current ? 600 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: chapter.time-text;
                    color: Theme.secondary-text;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Track rows; Rust adds a "None" row (id 0) where deselecting is possible.
component TrackList inherits VerticalLayout {
    in property <[TrackItem]> tracks;
    callback choose(int);
    spacing: 0;

    for track in root.tracks: ChoiceRow {
        title: track.title;
        detail: track.detail;
        selected: track.selected;
        clicked => {
            root.choose(track.id);
        }
    }
}

// Speed uses a log₂ scale from 0.25× to 16×, like IINA.
component SpeedControl inherits VerticalLayout {
    spacing: 2px;
    HorizontalLayout {
        Text {
            text: "Speed";
            color: Theme.text;
            font-size: Theme.font-normal;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Text {
            text: (round(Playback.speed * 100) / 100) + "×";
            color: Theme.secondary-text;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        IconButton {
            width: 20px;
            height: 20px;
            icon: @image-url("icons/rotate-ccw.svg");
            icon-size: 13px;
            enabled: Playback.speed != 1;
            tooltip: "Reset speed";
            clicked => {
                Actions.set("speed", "1");
            }
        }
    }
    Slider {
        value: log(Playback.speed, 2);
        minimum: -2;
        maximum: 4;
        scroll-step: 0.25;
        changed(value) => {
            let speed = pow(2, value);
            // Snap to 1× near the middle.
            Actions.set("speed", abs(value) < 0.08 ? "1" : round(speed * 100) / 100);
        }
    }
    HorizontalLayout {
        for label in ["0.25×", "1×", "4×", "16×"]: Text {
            text: label;
            color: Theme.tertiary-text;
            font-size: 10px;
            horizontal-alignment: label == "0.25×" ? left : label == "16×" ? right : center;
            horizontal-stretch: 1;
        }
    }
}

component VideoPanel inherits ScrollView {
    VerticalLayout {
        padding-right: 8px;
        spacing: 14px;

        if Media.video-tracks.length > 1: PanelSection {
            title: "VIDEO TRACK";
            TrackList {
                tracks: Media.video-tracks;
                choose(id) => {
                    Actions.select-track("video", id);
                }
            }
        }

        PanelSection {
            title: "ASPECT RATIO";
            Segmented {
                options: ["Default", "4:3", "16:9", "16:10", "21:9", "5:4"];
                selected: Playback.aspect-index;
                activated(index) => {
                    Actions.patina("aspect " + index);
                }
            }
        }

        PanelSection {
            title: "CROP";
            Segmented {
                options: ["None", "4:3", "16:9", "16:10", "21:9", "5:4"];
                selected: Playback.crop-index;
                activated(index) => {
                    Actions.patina("crop " + index);
                }
            }
        }

        PanelSection {
            title: "ROTATION";
            Segmented {
                options: ["0°", "90°", "180°", "270°"];
                selected: Playback.rotation / 90;
                activated(index) => {
                    Actions.set("video-rotate", index * 90);
                }
            }
            SettingRow {
                label: "Flip vertically";
                Switch {
                    y: 4px;
                    checked: Playback.flipped;
                    toggled => {
                        Actions.patina("toggle-flip");
                    }
                }
            }
            SettingRow {
                label: "Mirror horizontally";
                Switch {
                    y: 4px;
                    checked: Playback.mirrored;
                    toggled => {
                        Actions.patina("toggle-mirror");
                    }
                }
            }
        }

        Divider { }
        SpeedControl { }
        Divider { }

        PanelSection {
            SettingRow {
                label: "Deinterlace";
                Switch {
                    y: 4px;
                    checked: Playback.deinterlace;
                    toggled(on) => {
                        Actions.set("deinterlace", on ? "yes" : "no");
                    }
                }
            }
            SettingRow {
                label: "Hardware decoding";
                Switch {
                    y: 4px;
                    checked: Playback.hwdec;
                    toggled(on) => {
                        Actions.patina(on ? "hwdec on" : "hwdec off");
                    }
                }
            }
            if Playback.hwdec-current != "": Text {
                text: "Decoder: " + Playback.hwdec-current;
                color: Theme.tertiary-text;
                font-size: Theme.font-small;
            }
        }

        Divider { }

        PanelSection {
            title: "COLOR";
            ValueSlider {
                label: "Brightness";
                value: Playback.brightness;
                changed(value) => {
                    Actions.set("brightness", round(value));
                }
            }
            ValueSlider {
                label: "Contrast";
                value: Playback.contrast;
                changed(value) => {
                    Actions.set("contrast", round(value));
                }
            }
            ValueSlider {
                label: "Saturation";
                value: Playback.saturation;
                changed(value) => {
                    Actions.set("saturation", round(value));
                }
            }
            ValueSlider {
                label: "Gamma";
                value: Playback.gamma;
                changed(value) => {
                    Actions.set("gamma", round(value));
                }
            }
            ValueSlider {
                label: "Hue";
                value: Playback.hue;
                changed(value) => {
                    Actions.set("hue", round(value));
                }
            }
        }

        if Playback.video-info != "": Text {
            text: Playback.video-info;
            color: Theme.tertiary-text;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
    }
}

component EqualizerBand inherits VerticalLayout {
    in property <float> gain;
    in property <string> label;
    callback changed(float);
    spacing: 4px;
    alignment: center;

    Rectangle {
        width: 20px;
        height: 100px;
        property <float> fraction: clamp((root.gain + 12) / 24, 0, 1);

        Rectangle {
            width: 3px;
            border-radius: 1.5px;
            background: Theme.track;
        }
        Rectangle {
            y: parent.height / 2;
            width: 9px;
            height: 1px;
            background: Theme.tertiary-text;
        }
        Rectangle {
            y: (parent.height - self.height) * (1 - parent.fraction);
            width: 14px;
            height: 8px;
            border-radius: 4px;
            background: Theme.knob;
            drop-shadow-blur: 2px;
            drop-shadow-color: #00000066;
        }

        TouchArea {
            function update(y: length) {
                let f = 1 - clamp((y - 4px) / (self.height - 8px), 0, 1);
                root.changed(round((f * 24 - 12) * 2) / 2);
            }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    self.update(self.mouse-y);
                }
            }
            moved => {
                if self.pressed {
                    self.update(self.mouse-y);
                }
            }
            double-clicked => {
                root.changed(0);
            }
        }
    }

    Text {
        text: root.label;
        color: Theme.tertiary-text;
        font-size: 9px;
        horizontal-alignment: center;
    }
}

component AudioPanel inherits ScrollView {
    VerticalLayout {
        padding-right: 8px;
        spacing: 14px;

        PanelSection {
            title: "AUDIO TRACK";
            TrackList {
                tracks: Media.audio-tracks;
                choose(id) => {
                    Actions.select-track("audio", id);
                }
            }
            HorizontalLayout {
                alignment: start;
                TextButton {
                    text: "Load External Audio…";
                    enabled: Playback.has-media;
                    clicked => {
                        Actions.patina("load-audio");
                    }
                }
            }
        }

        Divider { }

        ValueSlider {
            label: "Audio delay";
            value: Playback.audio-delay;
            minimum: -5;
            maximum: 5;
            step: 0.05;
            value-text: Format.signed-seconds(Playback.audio-delay);
            changed(value) => {
                Actions.set("audio-delay", round(value * 100) / 100);
            }
        }

        Divider { }

        PanelSection {
            title: "EQUALIZER";
            HorizontalLayout {
                spacing: 2px;
                alignment: space-between;
                for label[index] in ["32", "64", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"]: EqualizerBand {
                    label: label;
                    gain: Playback.eq-gains[index];
                    changed(gain) => {
                        Actions.set-eq(index, gain);
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                TextButton {
                    text: "Reset";
                    clicked => {
                        Actions.set-eq(-1, 0);
                    }
                }
            }
        }

        if Media.audio-devices.length > 0: PanelSection {
            title: "OUTPUT DEVICE";
            for device in Media.audio-devices: ChoiceRow {
                title: device.description;
                selected: device.selected;
                clicked => {
                    Actions.set("audio-device", device.name);
                }
            }
        }

        if Playback.audio-info != "": Text {
            text: Playback.audio-info;
            color: Theme.tertiary-text;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
    }
}

component SubtitlesPanel inherits ScrollView {
    property <int> which: 0;

    VerticalLayout {
        padding-right: 8px;
        spacing: 14px;

        Segmented {
            options: ["Primary", "Secondary"];
            selected: root.which;
            activated(index) => {
                root.which = index;
            }
        }

        if root.which == 0: TrackList {
            tracks: Media.sub-tracks;
            choose(id) => {
                Actions.select-track("sub", id);
            }
        }

        if root.which == 1: TrackList {
            tracks: Media.secondary-sub-tracks;
            choose(id) => {
                Actions.select-secondary-sub(id);
            }
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            TextButton {
                text: "Load External…";
                enabled: Playback.has-media;
                clicked => {
                    Actions.patina("load-subtitles");
                }
            }
        }

        Divider { }

        SettingRow {
            label: root.which == 0 ? "Show subtitles" : "Show secondary subtitles";
            Switch {
                y: 4px;
                checked: root.which == 0 ? Playback.sub-visible : Playback.secondary-sub-visible;
                toggled(on) => {
                    Actions.set(root.which == 0 ? "sub-visibility" : "secondary-sub-visibility", on ? "yes" : "no");
                }
            }
        }

        ValueSlider {
            label: "Delay";
            property <float> delay: root.which == 0 ? Playback.sub-delay : Playback.secondary-sub-delay;
            value: self.delay;
            minimum: -10;
            maximum: 10;
            step: 0.05;
            value-text: Format.signed-seconds(self.delay);
            changed(value) => {
                Actions.set(root.which == 0 ? "sub-delay" : "secondary-sub-delay", round(value * 100) / 100);
            }
        }

        if root.which == 0: ValueSlider {
            label: "Scale";
            value: Playback.sub-scale;
            minimum: 0.25;
            maximum: 3;
            step: 0.05;
            default-value: 1;
            centered: false;
            value-text: (round(Playback.sub-scale * 100) / 100) + "×";
            changed(value) => {
                Actions.set("sub-scale", round(value * 100) / 100);
            }
        }

        if root.which == 0: ValueSlider {
            label: "Position";
            value: Playback.sub-pos;
            minimum: 0;
            maximum: 150;
            step: 1;
            default-value: 100;
            centered: false;
            changed(value) => {
                Actions.set("sub-pos", round(value));
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in-out property <string> tab;
    // Music mode's drawer under the controls, rather than a panel at the
    // side: no close button, and a line along the top instead.
    in property <bool> drawer;
    callback close;

    property <bool> playlist-group: root.tab == "playlist" || root.tab == "chapters";

    width: Theme.sidebar-width;
    background: Theme.panel-background;
    border-width: 0;

    // Keep clicks and scrolling from reaching the video below.
    TouchArea {
        scroll-event(event) => {
            return accept;
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: root.drawer ? parent.width : 1px;
        height: root.drawer ? 1px : parent.height;
        background: Theme.panel-divider;
    }

    VerticalLayout {
        padding: 12px;
        padding-top: 14px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            Segmented {
                horizontal-stretch: 1;
                options: root.playlist-group ? ["Playlist", "Chapters"] : ["Video", "Audio", "Subtitles"];
                selected: root.tab == "playlist" || root.tab == "video" ? 0 : root.tab == "chapters" || root.tab == "audio" ? 1 : 2;
                activated(index) => {
                    root.tab = root.playlist-group ? (index == 0 ? "playlist" : "chapters") : (index == 0 ? "video" : index == 1 ? "audio" : "subtitles");
                }
            }
            if !root.drawer: IconButton {
                y: -2px;
                icon: @image-url("icons/x.svg");
                icon-size: 13px;
                hover-background: true;
                tooltip: "Close";
                clicked => {
                    root.close();
                }
            }
        }

        if root.tab == "playlist": PlaylistPanel {
            vertical-stretch: 1;
        }
        if root.tab == "chapters": ChaptersPanel {
            vertical-stretch: 1;
        }
        if root.tab == "video": VideoPanel {
            vertical-stretch: 1;
        }
        if root.tab == "audio": AudioPanel {
            vertical-stretch: 1;
        }
        if root.tab == "subtitles": SubtitlesPanel {
            vertical-stretch: 1;
        }
    }
}
