import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Media, Actions, Platform } from "globals.slint";
import { IconButton, SectionTitle } from "widgets.slint";
import { Library } from "library-model.slint";

component WelcomeAction inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> detail;
    callback clicked;
    height: 44px;
    border-radius: Theme.panel-radius;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Image {
            source: root.icon;
            width: 20px;
            colorize: Theme.playing;
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-normal;
                font-weight: 600;
                overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.tertiary-text;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Shown while nothing is loaded, laid out like IINA's welcome window.
export component WelcomeView inherits Rectangle {
    in property <bool> drop-active;
    // Clear Recent was pressed. The window asks first, since clearing empties
    // the whole history.
    callback clear-recent;
    background: #141416;

    HorizontalLayout {
        padding: 28px;
        padding-top: 52px;
        spacing: 28px;

        Rectangle {
            width: min(300px, root.width * 0.45);

            // Scrolls only when the window is too short for it, as with many
            // servers; otherwise a press here still moves the window. It
            // starts a pixel up and to the left of the column, whose padding
            // takes the pixel back, since it clips and the logo's soft edge
            // falls just outside the tile.
            actions := Flickable {
                x: -1px;
                y: -1px;
                width: parent.width + 1px;
                height: parent.height + 1px;
                interactive: column.preferred-height > self.height;
                content-height: column.preferred-height;

                column := VerticalLayout {
                    width: actions.width;
                    height: self.preferred-height;
                    padding-left: 1px;
                    padding-top: 1px;
                    spacing: 6px;

                    // The icon's tile fills 208 of its 256 units (Flathub's
                    // grid); the margin around it is cropped so the tile lines
                    // up with the title below.
                    Rectangle {
                        width: 67px;
                        height: 67px;
                        Image {
                            x: -(self.width - parent.width) / 2;
                            y: -(self.height - parent.height) / 2;
                            width: parent.width * 256 / 208;
                            height: parent.height * 256 / 208;
                            source: @image-url("icons/patina.svg");
                        }
                    }
                    Text {
                        text: "Patina";
                        color: Theme.text;
                        font-size: 26px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Version " + Platform.version;
                        color: Theme.tertiary-text;
                        font-size: Theme.font-small;
                    }
                    Rectangle {
                        height: 18px;
                    }
                    if Media.resume-title != "": WelcomeAction {
                        icon: @image-url("icons/play.svg");
                        title: "Resume Last Playback";
                        detail: Media.resume-title;
                        clicked => {
                            Actions.open-recent(0);
                        }
                    }
                    WelcomeAction {
                        icon: @image-url("icons/folder-open.svg");
                        title: "Open…";
                        detail: "Files or a folder";
                        clicked => {
                            Actions.patina("open-file");
                        }
                    }
                    WelcomeAction {
                        icon: @image-url("icons/link.svg");
                        title: "Open URL…";
                        detail: "Streams and online video";
                        clicked => {
                            Actions.patina("open-url");
                        }
                    }
                    WelcomeAction {
                        icon: @image-url("icons/list-video.svg");
                        title: "YouTube";
                        detail: "Your channels, search and Watch Later";
                        clicked => {
                            Actions.patina("youtube");
                        }
                    }
                    // The servers signed in to, and those asking to be signed
                    // in to again: each opens its library, which is never where
                    // Patina starts.
                    for server in Library.all-servers: WelcomeAction {
                        icon: @image-url("icons/server.svg");
                        title: server.title;
                        detail: server.detail;
                        clicked => {
                            Library.open-server(server.id);
                        }
                    }
                    WelcomeAction {
                        icon: Library.all-servers.length > 0 ? @image-url("icons/plus.svg") : @image-url("icons/server.svg");
                        title: Library.all-servers.length > 0 ? "Add Server…" : "Jellyfin…";
                        detail: Library.all-servers.length > 0 ? "Browse another Jellyfin server" : "Browse a Jellyfin server";
                        clicked => {
                            Actions.patina("jellyfin-sign-in");
                        }
                    }
                }
            }
        }

        Rectangle {
            border-radius: Theme.panel-radius;
            background: #ffffff08;
            border-width: 1px;
            border-color: Theme.panel-divider;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    height: 28px;
                    spacing: 8px;
                    SectionTitle {
                        horizontal-stretch: 1;
                        text: "Recent";
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if Media.recent.length > 0: IconButton {
                        icon: @image-url("icons/trash-2.svg");
                        icon-size: 16px;
                        hover-background: true;
                        tooltip: "Clear Recent…";
                        clicked => {
                            root.clear-recent();
                        }
                    }
                }
                if Media.recent.length == 0: Rectangle {
                    vertical-stretch: 1;
                    Text {
                        text: "Files you play appear here.";
                        color: Theme.tertiary-text;
                        font-size: Theme.font-normal;
                    }
                }
                if Media.recent.length > 0: ListView {
                    vertical-stretch: 1;
                    for item[index] in Media.recent: Rectangle {
                        height: 40px;
                        border-radius: Theme.control-radius;
                        background: touch.has-hover ? Theme.hover : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 10px;
                            Image {
                                source: @image-url("icons/file-play.svg");
                                width: 18px;
                                colorize: #8cb4ff;
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: item.title;
                                    color: Theme.text;
                                    font-size: Theme.font-normal;
                                    overflow: elide;
                                }
                                Text {
                                    text: item.detail;
                                    color: Theme.tertiary-text;
                                    font-size: Theme.font-small;
                                    overflow: elide;
                                }
                            }
                        }
                        touch := TouchArea {
                            clicked => {
                                Actions.open-recent(index);
                            }
                        }
                    }
                }
            }
        }
    }

    if root.drop-active: Rectangle {
        background: #000000a0;
        Rectangle {
            x: 16px;
            y: 44px;
            width: parent.width - 32px;
            height: parent.height - 60px;
            border-radius: 14px;
            border-width: 2px;
            border-color: Theme.playing;
            VerticalLayout {
                alignment: center;
                spacing: 10px;
                Image {
                    source: @image-url("icons/file-down.svg");
                    height: 40px;
                    colorize: Theme.playing;
                }
                Text {
                    text: "Drop to play";
                    color: Theme.text;
                    font-size: 18px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
